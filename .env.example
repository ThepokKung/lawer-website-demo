# ==============================================================================
# THANPRAT LAWYER CO., LTD. — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วปรับแต่งค่าตามต้องการ

# อีเมลหลักสำหรับรับข้อมูลจากแบบฟอร์มปรึกษา และลิงก์ติดต่อด่วนบนเว็บไซต์
PUBLIC_CONTACT_EMAIL=thanprat.lawyer@gmail.com

# เบอร์โทรศัพท์ติดต่อ
PUBLIC_CONTACT_PHONE=+66 82 156 5651
PUBLIC_CONTACT_PHONE_MOBILE=+66 64 829 8888

# ช่องทาง LINE Official
PUBLIC_CONTACT_LINE=@thanpratlawyer
PUBLIC_CONTACT_LINE_URL=https://line.me/ti/p/~thanprat.lawyer

# Facebook Page URL
PUBLIC_CONTACT_FACEBOOK=https://www.facebook.com/thanprat.lawyer

# URL ของเว็บไซต์
PUBLIC_SITE_URL=https://law.thepokkung.space

# (ไม่บังคับ) ลิงก์ Google Apps Script Web App หากต้องการบันทึกลง Google Sheet
# หากเว้นว่างไว้ ระบบจะส่งอีเมลเข้า PUBLIC_CONTACT_EMAIL ฟรีอัตโนมัติผ่าน FormSubmit Gateway
PUBLIC_GOOGLE_SCRIPT_URL=

# (ไม่บังคับ) Cloudflare Turnstile Site Key
PUBLIC_TURNSTILE_SITE_KEY=

# (ไม่บังคับ) Google Tag Manager Container ID
PUBLIC_GTM_ID=
