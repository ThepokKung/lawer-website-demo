# ==============================================================================
# Essential Keys & Endpoints (.env.example)
# ตั้งค่าเฉพาะ Key และ Endpoint สำคัญสำหรับ Cloudflare Auto Deploy
# (Microsoft Clarity & GA4 สามารถผูกผ่าน Google Tag Manager ได้โดยตรง)
# ==============================================================================

# 1. โดเมนหลักของเว็บไซต์ (เช่น https://law.thepokkung.space)
PUBLIC_SITE_URL=https://law.thepokkung.space

# 2. Webhook รับฟอร์มเข้า Google Sheets และส่ง Email (จาก Google Apps Script)
PUBLIC_GOOGLE_SCRIPT_URL=

# 3. Google Tag Manager ID (ใช้ตัวเดียวคุมทั้ง GA4, Microsoft Clarity, Ads)
PUBLIC_GTM_ID=

# 4. (ทางเลือก) Cloudflare Turnstile Site Key ป้องกัน Spam (หากไม่ใส่ ระบบจะใช้ Honeypot Shield ดักจับบอทอัตโนมัติ)
PUBLIC_TURNSTILE_SITE_KEY=
