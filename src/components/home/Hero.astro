---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative pt-16 pb-20 md:pt-24 md:pb-32 overflow-hidden bg-gradient-to-b from-white via-slate-50 to-slate-100/60 border-b border-slate-200">
  <!-- Architectural Subtle Grid / Decorative Accents -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#00000008_1px,transparent_1px),linear-gradient(to_bottom,#00000008_1px,transparent_1px)] bg-[size:48px_48px] pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Sharp Prestige Badge -->
    <div class="reveal-init inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-[2px] bg-gold-100 border border-gold-300/80 text-gold-800 text-xs font-bold tracking-widest uppercase mb-8 shadow-xs">
      <span class="w-2 h-2 rounded-xs bg-gold-600"></span>
      {t.hero.badge}
    </div>

    <!-- Apple-style Big Staggered Typography with Sharp Architectural Authority -->
    <h1 class="reveal-init stagger-1 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-navy-950 leading-[1.15] mb-6">
      <span class="block">{t.hero.title1}</span>
      <span class="block text-gold-600 mt-1 font-serif italic font-bold">{t.hero.title2}</span>
    </h1>

    <p class="reveal-init stagger-2 max-w-2xl mx-auto text-base sm:text-lg md:text-xl text-slate-600 font-normal leading-relaxed mb-10">
      {t.hero.lead}
    </p>

    <!-- Sharp CTAs -->
    <div class="reveal-init stagger-3 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`/${lang}/contact/`}
        class="w-full sm:w-auto sm:min-w-[240px] h-13 inline-flex items-center justify-center px-8 text-sm font-bold uppercase tracking-wider text-white rounded-[2px] bg-navy-900 hover:bg-gold-600 transition-all duration-300 shadow-md hover:shadow-lg active:scale-[0.98] text-center"
      >
        <span>{t.hero.ctaConsultation}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>

      <a
        href={`/${lang}/services/`}
        class="w-full sm:w-auto sm:min-w-[220px] h-13 inline-flex items-center justify-center px-8 text-sm font-bold uppercase tracking-wider text-navy-950 hover:text-navy-900 rounded-[2px] bg-white hover:bg-slate-50 border border-slate-300/90 transition-all duration-300 shadow-xs hover:border-navy-900 active:scale-[0.98] text-center"
      >
        {t.hero.ctaServices}
      </a>
    </div>

    <!-- Trust Note -->
    <div class="reveal-init stagger-4 mt-12 pt-6 border-t border-slate-200 text-xs sm:text-sm text-slate-500 flex items-center justify-center gap-2">
      <svg class="w-4 h-4 text-gold-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>{t.hero.trustNote}</span>
    </div>

  </div>
</section>
