---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  <!-- Subtle Background Glows -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-navy-700/30 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/4 w-[350px] h-[350px] bg-gold-500/10 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    
    <!-- Prestige Badge -->
    <div class="reveal-init inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-navy-900/80 border border-gold-500/30 text-gold-300 text-xs font-semibold tracking-wider uppercase mb-8 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-gold-400 animate-pulse"></span>
      {t.hero.badge}
    </div>

    <!-- Apple-style Big Staggered Typography -->
    <h1 class="reveal-init stagger-1 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-slate-50 leading-[1.15] mb-6">
      <span class="block">{t.hero.title1}</span>
      <span class="block gold-gradient-text mt-1">{t.hero.title2}</span>
    </h1>

    <p class="reveal-init stagger-2 max-w-2xl mx-auto text-base sm:text-lg md:text-xl text-slate-300 font-light leading-relaxed mb-10">
      {t.hero.lead}
    </p>

    <!-- CTAs with Apple-grade smooth button feel -->
    <div class="reveal-init stagger-3 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={`/${lang}/contact/`}
        class="w-full sm:w-auto sm:min-w-[240px] h-14 inline-flex items-center justify-center px-8 text-sm font-semibold tracking-wide uppercase text-navy-950 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 hover:from-gold-300 hover:to-gold-400 shadow-lg shadow-gold-500/25 transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] text-center"
      >
        <span>{t.hero.ctaConsultation}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>

      <a
        href={`/${lang}/services/`}
        class="w-full sm:w-auto sm:min-w-[220px] h-14 inline-flex items-center justify-center px-8 text-sm font-medium tracking-wide text-slate-200 hover:text-white rounded-xl bg-navy-900/80 hover:bg-navy-850 border border-slate-700/80 hover:border-gold-500/40 backdrop-blur-md transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] text-center"
      >
        {t.hero.ctaServices}
      </a>
    </div>

    <!-- Trust Note -->
    <div class="reveal-init stagger-4 mt-10 pt-6 border-t border-slate-800/60 text-xs sm:text-sm text-slate-400 flex items-center justify-center gap-2">
      <svg class="w-4 h-4 text-gold-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
      <span>{t.hero.trustNote}</span>
    </div>

  </div>
</section>
