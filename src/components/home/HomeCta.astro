---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal-init glass-card rounded-3xl p-8 sm:p-12 lg:p-16 border border-gold-500/30 text-center relative overflow-hidden bg-gradient-to-b from-navy-850 to-navy-950 shadow-2xl">
      
      <!-- Background Ambient Glow -->
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
          {t.contact.title}
        </h2>
        <p class="text-base sm:text-lg text-slate-300 mb-8 leading-relaxed">
          {t.contact.subtitle}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={`/${lang}/contact/`}
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-sm font-semibold uppercase tracking-wider text-navy-950 rounded-xl bg-gradient-to-r from-gold-400 via-gold-500 to-gold-400 hover:from-gold-300 hover:to-gold-400 shadow-xl shadow-gold-500/25 transition-all duration-300 hover:scale-[1.02] active:scale-[0.98]"
          >
            {t.hero.ctaConsultation}
          </a>

          <a
            href={`tel:${t.contact.phoneValue.replace(/\s+/g, '')}`}
            class="track-call w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 text-sm font-semibold text-slate-100 hover:text-white rounded-xl bg-navy-900 border border-slate-700 hover:border-gold-500/40 transition-all duration-300"
            data-phone={t.contact.phoneValue}
          >
            <span class="mr-2">📞</span>
            <span>{t.contact.phoneValue}</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
