---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20 relative overflow-hidden bg-white border-t border-slate-200">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal-init rounded-[2px] p-8 sm:p-12 lg:p-16 border border-navy-800 text-center relative overflow-hidden bg-navy-950 text-white shadow-2xl">
      
      <!-- Subtle Architectural Accent Lines -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:32px_32px] pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl mx-auto">
        <div class="inline-block px-3.5 py-1.5 rounded-[2px] bg-gold-500/20 border border-gold-400/40 text-gold-300 text-xs font-bold uppercase tracking-wider mb-5 sm:mb-6">
          Direct Counsel
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-[1.3] sm:leading-[1.25] mb-4 sm:mb-5">
          {t.contact.title}
        </h2>
        <p class="text-base sm:text-lg text-slate-300 mb-10 leading-relaxed font-normal">
          {t.contact.subtitle}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5">
          <a
            href={`/${lang}/contact/`}
            class="w-full sm:w-auto sm:min-w-[250px] inline-flex items-center justify-center px-9 py-4 sm:py-4.5 text-sm sm:text-base font-bold uppercase tracking-wider text-white rounded-[2px] bg-gradient-to-r from-gold-600 via-gold-500 to-gold-600 hover:from-gold-700 hover:to-gold-600 shadow-xl transition-all duration-300 active:scale-[0.98]"
          >
            {t.hero.ctaConsultation}
          </a>

          <a
            href={`tel:${t.contact.phoneValue.replace(/\s+/g, '')}`}
            class="track-call w-full sm:w-auto sm:min-w-[230px] inline-flex items-center justify-center px-9 py-4 sm:py-4.5 text-sm sm:text-base font-bold uppercase tracking-wider text-slate-100 hover:text-white rounded-[2px] bg-navy-900 border border-navy-700 hover:border-gold-500 transition-all duration-300"
            data-phone={t.contact.phoneValue}
          >
            <svg class="w-4 h-4 mr-2.5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>{t.contact.phoneValue}</span>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
