---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-16 lg:py-24 bg-white border-b border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="reveal-init inline-block px-3.5 py-1.5 rounded-[2px] bg-gold-100 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider mb-4 sm:mb-5">
        {t.clientsSection?.sectionBadge || "OUR CLIENTS"}
      </div>
      <h2 class="reveal-init stagger-1 text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-navy-950 leading-[1.3] mb-4">
        {t.clientsSection?.title || "องค์กรธุรกิจและสถาบันชั้นนำที่ไว้วางใจ"}
      </h2>
      <p class="reveal-init stagger-2 text-sm sm:text-base text-slate-600 leading-relaxed">
        {t.clientsSection?.subtitle || "เราภาคภูมิใจที่ได้ร่วมสร้างความสำเร็จและพิทักษ์ความมั่นคงทางกฎหมายให้แก่องค์กรชั้นนำ"}
      </p>
    </div>

    <!-- Clients Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {(t.clientsSection?.clients || []).map((client, idx) => {
        const clientName = typeof client === 'string' ? client : client.name;
        const clientLogo = typeof client === 'string' ? null : client.logo;
        const clientCategory = typeof client === 'string' ? null : client.category;

        return (
          <div
            class:list={[
              "reveal-init rounded-[2px] p-3.5 sm:p-4 bg-white border border-slate-200/90 hover:border-forest-500 hover:shadow-md hover:translate-y-[-2px] transition-all duration-300 flex items-center gap-3.5 sm:gap-4 group",
              `stagger-${(idx % 4) + 1}`
            ]}
          >
            <!-- Logo Box -->
            <div class="w-16 h-14 sm:w-20 sm:h-16 rounded-[2px] bg-slate-50/70 border border-slate-200/70 group-hover:border-forest-300 group-hover:bg-white flex items-center justify-center p-2 shrink-0 transition-all duration-300">
              {clientLogo ? (
                <img
                  src={clientLogo}
                  alt={clientName}
                  loading="lazy"
                  width="68"
                  height="44"
                  class="max-h-10 sm:max-h-11 max-w-[54px] sm:max-w-[68px] w-auto h-auto object-contain transition-transform duration-300 group-hover:scale-105"
                />
              ) : (
                <div class="w-8 h-8 rounded-[2px] bg-forest-100 border border-forest-200 text-forest-700 flex items-center justify-center shrink-0 font-bold text-xs group-hover:bg-navy-900 group-hover:text-gold-400 group-hover:border-navy-900 transition-colors duration-300">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
              )}
            </div>

            <!-- Client Info -->
            <div class="min-w-0 flex-1">
              {clientCategory && (
                <span class="block text-[10px] sm:text-[10.5px] font-bold text-forest-700 uppercase tracking-wider mb-0.5 line-clamp-1">
                  {clientCategory}
                </span>
              )}
              <h3 class="text-xs sm:text-sm font-bold text-navy-950 group-hover:text-forest-900 transition-colors leading-snug line-clamp-2">
                {clientName}
              </h3>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Bottom Trust Footer -->
    <div class="reveal-init stagger-3 mt-10 pt-6 text-center border-t border-slate-100 text-xs text-slate-600">
      <span>{lang === 'th' ? 'ครอบคลุมทั้งสถาบันการเงิน บริษัทจดทะเบียนในตลาดหลักทรัพย์ และองค์กรข้ามชาติชั้นนำ' : 'Serving financial institutions, publicly listed enterprises, and multinational corporations'}</span>
    </div>

  </div>
</section>
