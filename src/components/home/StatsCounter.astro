---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const statsList = Object.values(t.stats);
---

<section class="py-12 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      {statsList.map((stat, index) => (
        <div class:list={[
          "reveal-init text-center p-3.5 sm:p-6 rounded-[2px] bg-slate-50/80 border border-slate-200/80 hover:border-gold-500 transition-colors duration-300 shadow-xs",
          `stagger-${index + 1}`
        ]}>
          <div class="text-2xl sm:text-4xl lg:text-5xl font-black text-navy-950 tracking-tight mb-1 sm:mb-2">
            {stat.value}
          </div>
          <div class="text-xs sm:text-sm font-bold text-slate-800 mb-1 leading-snug">
            {stat.label}
          </div>
          <div class="text-[10px] sm:text-xs text-slate-500 leading-tight">
            {stat.sub}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
