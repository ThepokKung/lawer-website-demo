---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const statsList = [
  t.stats.experience,
  t.stats.successRate,
  t.stats.corporateClients,
  t.stats.assetsProtected
];
---

<section class="py-12 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {statsList.map((stat, index) => (
        <div class:list={[
          "reveal-init text-center p-6 rounded-[2px] bg-slate-50/80 border border-slate-200/80 hover:border-gold-500 transition-colors duration-300 shadow-xs",
          `stagger-${index + 1}`
        ]}>
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-navy-950 tracking-tight mb-2">
            {stat.value}
          </div>
          <div class="text-sm font-bold text-slate-800 mb-1">
            {stat.label}
          </div>
          <div class="text-xs text-slate-500">
            {stat.sub}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
