---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20 lg:py-28 relative bg-slate-50/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="reveal-init inline-block px-3.5 py-1.5 rounded-[2px] bg-gold-100 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider mb-5 sm:mb-6">
        {t.teamSection.sectionBadge}
      </div>
      <h2 class="reveal-init stagger-1 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-navy-950 leading-[1.3] sm:leading-[1.25] mb-4 sm:mb-5">
        {t.teamSection.title}
      </h2>
      <p class="reveal-init stagger-2 text-base sm:text-lg text-slate-600">
        {t.teamSection.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6">
      {t.teamSection.members.map((member, index) => (
        <div
          class:list={[
            "reveal-init glass-card glass-card-hover rounded-[2px] p-5 sm:p-6 flex flex-col justify-between bg-white border border-slate-200/90 shadow-sm",
            `stagger-${index + 1}`
          ]}
        >
          <div>
            <!-- Sharp Real Attorney Photo (Portrait) -->
            <a
              href={`/${lang}/team/${member.slug}/`}
              class="relative w-full aspect-[4/5] rounded-[2px] overflow-hidden border border-slate-200 mb-5 shadow-xs group/photo bg-slate-100 block"
            >
              <img
                src={member.image}
                alt={member.name}
                class="w-full h-full object-cover object-top filter brightness-[1.01] contrast-[1.02] group-hover/photo:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
                width="400"
                height="500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/25 via-transparent to-transparent pointer-events-none"></div>
            </a>

            <h3 class="text-xl font-bold text-navy-950 mb-1 hover:text-gold-700 transition-colors">
              <a href={`/${lang}/team/${member.slug}/`}>{member.name}</a>
            </h3>
            <p class="text-xs font-bold uppercase tracking-wider text-gold-700 mb-4 min-h-[32px] flex items-center">
              {member.role}
            </p>

            <div class="p-3.5 rounded-[2px] bg-slate-100/90 border border-slate-200/90 mb-4 text-xs text-slate-700 min-h-[64px] flex items-center leading-relaxed">
              {member.credentials}
            </div>

            <p class="text-sm text-slate-600 leading-relaxed min-h-[72px]">
              {member.experience}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
            <a
              href={`/${lang}/team/${member.slug}/`}
              class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-navy-900 hover:text-gold-700 transition-colors group/link"
            >
              <span>{lang === 'th' ? 'ดูประวัติเต็ม' : 'View Profile'}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1 transform group-hover/link:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>

            <a
              href={`/${lang}/contact/?attorney=${encodeURIComponent(member.name)}`}
              class="text-xs font-semibold text-gold-700 hover:text-navy-950 transition-colors shrink-0"
              title={t.hero.ctaConsultation}
            >
              {lang === 'th' ? 'นัดปรึกษา' : 'Consult'}
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
