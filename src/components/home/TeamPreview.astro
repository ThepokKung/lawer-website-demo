---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20 lg:py-28 relative bg-slate-50/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="reveal-init inline-block px-3 py-1 rounded-[2px] bg-gold-100 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider mb-3">
        {t.teamSection.sectionBadge}
      </div>
      <h2 class="reveal-init stagger-1 text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-navy-950 mb-4">
        {t.teamSection.title}
      </h2>
      <p class="reveal-init stagger-2 text-base sm:text-lg text-slate-600">
        {t.teamSection.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {t.teamSection.members.map((member, index) => (
        <div
          class:list={[
            "reveal-init glass-card glass-card-hover rounded-[2px] p-8 flex flex-col justify-between bg-white border border-slate-200/90 shadow-sm",
            `stagger-${index + 1}`
          ]}
        >
          <div>
            <!-- Sharp Avatar Placeholder -->
            <div class="w-20 h-20 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400 mb-6 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            </div>

            <h3 class="text-xl font-bold text-navy-950 mb-1">
              {member.name}
            </h3>
            <p class="text-xs font-bold uppercase tracking-wider text-gold-700 mb-4 min-h-[32px] flex items-center">
              {member.role}
            </p>

            <div class="p-3.5 rounded-[2px] bg-slate-100/90 border border-slate-200/90 mb-4 text-xs text-slate-700 min-h-[64px] flex items-center leading-relaxed">
              {member.credentials}
            </div>

            <p class="text-sm text-slate-600 leading-relaxed min-h-[72px]">
              {member.experience}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100">
            <a
              href={`/${lang}/contact/?attorney=${encodeURIComponent(member.name)}`}
              class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-navy-900 hover:text-gold-700 transition-colors"
            >
              <span>{t.contact.formTitle}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
