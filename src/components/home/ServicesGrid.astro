---
import { useTranslations, type SupportedLang } from '@/i18n';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" class="py-20 lg:py-28 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="reveal-init inline-block px-3 py-1 rounded-full bg-navy-900 border border-gold-500/30 text-gold-300 text-xs font-semibold uppercase tracking-wider mb-3">
        {t.servicesSection.sectionBadge}
      </div>
      <h2 class="reveal-init stagger-1 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4">
        {t.servicesSection.title}
      </h2>
      <p class="reveal-init stagger-2 text-base sm:text-lg text-slate-400">
        {t.servicesSection.subtitle}
      </p>
    </div>

    <!-- 6 Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {t.services.map((service, index) => (
        <article
          class:list={[
            "reveal-init glass-card glass-card-hover rounded-2xl p-7 flex flex-col justify-between group",
            `stagger-${(index % 3) + 1}`
          ]}
        >
          <div>
            <!-- Icon Frame -->
            <div class="w-12 h-12 rounded-xl bg-navy-900 border border-gold-500/30 flex items-center justify-center text-gold-400 mb-6 group-hover:bg-gold-500 group-hover:text-navy-950 group-hover:border-gold-400 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20" />
                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
              </svg>
            </div>

            <!-- Title -->
            <h3 class="text-xl font-bold text-slate-100 group-hover:text-gold-300 transition-colors mb-3">
              {service.title}
            </h3>

            <!-- Description -->
            <p class="text-sm text-slate-400 leading-relaxed mb-6">
              {service.shortDesc}
            </p>
          </div>

          <!-- Bottom Action Link -->
          <div class="pt-4 border-t border-slate-800/80">
            <a
              href={`/${lang}/services/${service.slug}/`}
              class="inline-flex items-center text-sm font-semibold text-gold-400 group-hover:text-gold-300 transition-colors"
            >
              <span>{t.servicesSection.learnMore}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1.5 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Center Footer Action -->
    <div class="reveal-init text-center mt-12">
      <a
        href={`/${lang}/services/`}
        class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-slate-200 hover:text-white rounded-xl bg-navy-900 border border-slate-700 hover:border-gold-500/40 transition-all hover:scale-105"
      >
        {t.servicesSection.viewAll}
      </a>
    </div>

  </div>
</section>
