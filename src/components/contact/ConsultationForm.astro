---
import { useTranslations, type SupportedLang } from '@/i18n';
import { SITE_CONFIG } from '@/config/site';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const googleScriptUrl = SITE_CONFIG.googleScriptUrl;
const turnstileSiteKey = SITE_CONFIG.turnstileSiteKey;
---

<div class="rounded-[2px] p-5 sm:p-8 lg:p-10 border border-slate-200 bg-white shadow-sm">
  <div class="mb-8">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-950 mb-2">
      {t.contact.formTitle}
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
      {t.contact.formDesc}
    </p>
  </div>

  <form
    id="consultation-form"
    class="space-y-5"
    data-lang={lang}
    data-google-script-url={googleScriptUrl}
  >
    <!-- Anti-Spam Honeypot Field (Hidden from humans, traps automated scraping bots) -->
    <div
      class="opacity-0 absolute -left-[9999px] -top-[9999px] w-1 h-1 overflow-hidden pointer-events-none select-none"
      aria-hidden="true"
      tabindex="-1"
    >
      <label for="client-company-url">Do not fill this field if human</label>
      <input
        type="text"
        id="client-company-url"
        name="company_url_hp"
        tabindex="-1"
        autocomplete="off"
        value=""
      />
    </div>

    <!-- Success Banner -->
    <div id="form-success" class="hidden p-4 rounded-[2px] bg-emerald-50 border border-emerald-300 text-emerald-800 text-sm font-medium flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
      <span>{t.contact.successMsg}</span>
    </div>

    <!-- Error Banner -->
    <div id="form-error" class="hidden p-4 rounded-[2px] bg-rose-50 border border-rose-300 text-rose-800 text-sm font-medium flex items-center gap-2">
      <svg class="w-4 h-4 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
      <span>{t.contact.errorMsg}</span>
    </div>

    <!-- Name -->
    <div>
      <label for="client-name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
        {t.contact.fieldName}
      </label>
      <input
        type="text"
        id="client-name"
        name="name"
        required
        class="w-full px-4 py-3 rounded-[2px] bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900 text-sm transition-all shadow-xs"
        placeholder={lang === 'th' ? "ระบุชื่อ - นามสกุลของคุณ" : lang === 'zh' ? "请填写您的姓名" : "Enter your full name"}
      />
    </div>

    <!-- Email & Phone in 2 Columns -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="client-email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
          {t.contact.fieldEmail}
        </label>
        <input
          type="email"
          id="client-email"
          name="email"
          required
          class="w-full px-4 py-3 rounded-[2px] bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900 text-sm transition-all shadow-xs"
          placeholder="yourname@domain.com"
        />
      </div>

      <div>
        <label for="client-phone" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
          {t.contact.fieldPhone}
        </label>
        <input
          type="tel"
          id="client-phone"
          name="phone"
          required
          class="w-full px-4 py-3 rounded-[2px] bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900 text-sm transition-all shadow-xs"
          placeholder="+66 8X-XXX-XXXX"
        />
      </div>
    </div>

    <!-- Practice Area Select -->
    <div>
      <label for="client-service" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
        {t.contact.fieldService}
      </label>
      <select
        id="client-service"
        name="service"
        required
        class="w-full px-4 py-3 rounded-[2px] bg-white border border-slate-300 text-slate-900 focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900 text-sm transition-all shadow-xs"
      >
        <option value="">{t.contact.selectServiceDefault}</option>
        {t.services.map((service) => (
          <option value={service.title}>{service.title}</option>
        ))}
      </select>
    </div>

    <!-- Message -->
    <div>
      <label for="client-message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
        {t.contact.fieldMessage}
      </label>
      <textarea
        id="client-message"
        name="message"
        rows="4"
        required
        class="w-full px-4 py-3 rounded-[2px] bg-white border border-slate-300 text-slate-900 placeholder-slate-400 focus:outline-none focus:border-navy-900 focus:ring-1 focus:ring-navy-900 text-sm transition-all resize-y shadow-xs"
        placeholder={lang === 'th' ? "โปรดระบุข้อเท็จจริงเบื้องต้น วันที่เกิดเหตุการณ์ หรือความประสงค์ที่ต้องการให้สำนักงานช่วยเหลือ..." : lang === 'zh' ? "请简述咨询事由、关键时间节点或希望律所协助达成的目标..." : "Briefly describe the context, relevant dates, or what legal assistance you are seeking..."}
      ></textarea>
    </div>

    <!-- Optional Cloudflare Turnstile Smart Challenge (Rendered only when key is configured) -->
    {turnstileSiteKey && (
      <div class="flex justify-center my-3">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="light"></div>
      </div>
    )}

    <!-- Submit Button -->
    <button
      type="submit"
      id="btn-submit-form"
      class="w-full py-4 sm:py-4.5 text-sm sm:text-base font-bold uppercase tracking-wider text-white rounded-[2px] bg-navy-900 hover:bg-gold-600 shadow-md hover:shadow-lg transition-all duration-300 active:scale-[0.98]"
    >
      <span id="submit-text">{t.contact.fieldSubmit}</span>
    </button>

    <div class="text-[11px] text-slate-500 text-center leading-relaxed flex items-center justify-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-gold-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
      <span>{t.contact.subtitle}</span>
    </div>
  </form>
</div>

<script>
  import { trackEvent } from '@/utils/tracking';

  function setupConsultationForm() {
    const form = document.getElementById('consultation-form') as HTMLFormElement | null;
    const successBox = document.getElementById('form-success');
    const errorBox = document.getElementById('form-error');
    const submitBtn = document.getElementById('btn-submit-form') as HTMLButtonElement | null;
    const submitText = document.getElementById('submit-text');
    const serviceSelect = document.getElementById('client-service') as HTMLSelectElement | null;

    if (!form) return;

    // Track when form was mounted to protect against sub-second automated bot submissions
    const formMountedAt = Date.now();

    // Handle preselected service parameter from query string (e.g. ?service=...)
    const urlParams = new URLSearchParams(window.location.search);
    const preselectedService = urlParams.get('service');
    if (preselectedService && serviceSelect) {
      serviceSelect.value = preselectedService;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      const lang = form.getAttribute('data-lang') || 'th';
      const serviceVal = serviceSelect?.value || 'General Consultation';
      const googleScriptUrl = form.getAttribute('data-google-script-url') || '';

      const formData = new FormData(form);

      // Cloudflare Turnstile token (if present)
      const turnstileToken = (formData.get('cf-turnstile-response') || '').toString();

      if (submitBtn && submitText) {
        submitBtn.disabled = true;
        submitText.textContent = lang === 'th' ? 'กำลังส่งข้อมูล...' : lang === 'zh' ? '正在提交...' : 'Submitting...';
      }

      const payload: Record<string, any> = Object.fromEntries(formData);
      payload.lang = lang;
      payload.timestamp = new Date().toISOString();

      if (turnstileToken) {
        payload.turnstileToken = turnstileToken;
      }

      try {
        if (googleScriptUrl) {
          // Send to Google Apps Script Web App (logs to Google Sheet & sends Email)
          await fetch(googleScriptUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });
        } else {
          // Local/development preview mode
          console.info('[M&S Legal Lead Preview]: Form payload ready for Google & Email dispatch:', payload);
        }

        // Trigger Google Tag Manager / GA4 conversion event
        trackEvent('form_submit_lead', { service_interest: serviceVal, preferred_lang: lang });

        successBox?.classList.remove('hidden');
        errorBox?.classList.add('hidden');
        form.reset();

        if (submitText) {
          submitText.textContent = lang === 'th' ? 'ส่งคำขอนัดปรึกษาเรียบร้อย' : lang === 'zh' ? '已成功发送' : 'Submitted Successfully';
        }
      } catch (err) {
        console.error('Form submission failed:', err);
        errorBox?.classList.remove('hidden');
        successBox?.classList.add('hidden');

        if (submitText) {
          submitText.textContent = lang === 'th' ? 'เกิดข้อผิดพลาด ลองใหม่อีกครั้ง' : lang === 'zh' ? '提交失败，请重试' : 'Error, please retry';
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
        }
      }
    });
  }

  document.addEventListener('astro:page-load', setupConsultationForm);
</script>
