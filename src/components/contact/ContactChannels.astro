---
import { useTranslations, type SupportedLang } from '@/i18n';
import { SITE_CONFIG } from '@/config/site';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="space-y-6">
  <!-- Address Card -->
  <div class="reveal-init rounded-[2px] p-6 bg-white border border-slate-200 shadow-sm">
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400 shrink-0">
        <svg class="w-5 h-5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div>
        <h3 class="text-base font-bold text-navy-950 mb-1">{t.contact.addressLabel}</h3>
        <p class="text-sm text-slate-600 leading-relaxed">{t.contact.addressValue}</p>
        <p class="text-xs text-gold-700 font-semibold mt-2">BTS ช่องนนทรี (Chong Nonsi) ทางออก 1 / ทางเชื่อมตรงสู่อาคารสาทรสแควร์</p>
      </div>
    </div>
  </div>

  <!-- Contact Quick Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <!-- Phone Call -->
    <a
      href={`tel:${t.contact.phoneValue.replace(/\s+/g, '')}`}
      class="track-call reveal-init stagger-1 rounded-[2px] p-5 bg-white border border-slate-200 hover:border-gold-600 transition-all block group shadow-xs hover:shadow-sm"
      data-phone={t.contact.phoneValue}
    >
      <div class="flex items-center gap-3 mb-2">
        <span class="w-9 h-9 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </span>
        <div>
          <span class="block text-xs text-slate-500 uppercase font-bold">{t.contact.phoneLabel}</span>
          <span class="text-sm font-bold text-navy-950 group-hover:text-gold-700 transition-colors">{t.contact.phoneValue}</span>
        </div>
      </div>
      <span class="text-xs text-slate-500 block">{t.contact.phoneMobile}</span>
    </a>

    <!-- Email Inquiries -->
    <a
      href={`mailto:${t.contact.emailValue}`}
      class="track-email reveal-init stagger-2 rounded-[2px] p-5 bg-white border border-slate-200 hover:border-gold-600 transition-all block group shadow-xs hover:shadow-sm"
      data-email={t.contact.emailValue}
    >
      <div class="flex items-center gap-3 mb-2">
        <span class="w-9 h-9 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </span>
        <div class="min-w-0">
          <span class="block text-xs text-slate-500 uppercase font-bold">{t.contact.emailLabel}</span>
          <span class="text-sm font-bold text-navy-950 group-hover:text-gold-700 transition-colors truncate block">{t.contact.emailValue}</span>
        </div>
      </div>
      <span class="text-xs text-slate-500 block">ตอบกลับภายใน 24 ชม.</span>
    </a>

    <!-- LINE Official -->
    <a
      href={SITE_CONFIG.lineUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="track-line reveal-init stagger-3 rounded-[2px] p-5 bg-white border border-[#06C755]/30 hover:border-[#06C755] transition-all block group shadow-xs"
    >
      <div class="flex items-center gap-3">
        <span class="w-9 h-9 rounded-[2px] bg-[#06C755]/15 border border-[#06C755]/40 flex items-center justify-center text-[#06C755] font-black text-base">L</span>
        <div>
          <span class="block text-xs text-slate-500 uppercase font-bold">{t.contact.lineLabel}</span>
          <span class="text-sm font-bold text-[#06C755]">{t.contact.lineValue}</span>
        </div>
      </div>
    </a>

    <!-- WeChat -->
    <div
      id="wechat"
      class="reveal-init stagger-4 rounded-[2px] p-5 bg-white border border-[#07C160]/30 shadow-xs"
    >
      <div class="flex items-center gap-3">
        <span class="w-9 h-9 rounded-[2px] bg-[#07C160]/15 border border-[#07C160]/40 flex items-center justify-center text-[#07C160] font-black text-base">微</span>
        <div>
          <span class="block text-xs text-slate-500 uppercase font-bold">{t.contact.wechatLabel}</span>
          <span class="text-sm font-bold text-[#07C160]">{t.contact.wechatValue}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Business Hours -->
  <div class="reveal-init rounded-[2px] p-6 bg-white border border-slate-200 shadow-xs">
    <div class="flex items-center gap-3">
      <span class="w-9 h-9 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400 shrink-0">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" />
        </svg>
      </span>
      <div>
        <h4 class="text-sm font-bold text-navy-950 mb-1">{t.contact.hoursLabel}</h4>
        <p class="text-xs sm:text-sm text-slate-600">{t.contact.hoursValue}</p>
      </div>
    </div>
  </div>
</div>
