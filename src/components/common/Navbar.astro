---
import { useTranslations, type SupportedLang } from '@/i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: `/${lang}/`, label: t.nav.home },
  { href: `/${lang}/services/`, label: t.nav.services },
  { href: `/${lang}/about/`, label: t.nav.about },
  { href: `/${lang}/contact/`, label: t.nav.contact }
];
---

<header class="sticky top-0 z-40 w-full glass-nav transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 sm:h-20">
      
      <!-- Brand Logo (Left Wing) -->
      <div class="flex items-center justify-start min-w-0 pr-2">
        <a href={`/${lang}/`} class="flex items-center gap-2.5 sm:gap-3 group shrink-0">
          <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-[2px] overflow-hidden border border-navy-900 group-hover:border-gold-500 group-hover:shadow-md transition-all duration-300 shrink-0 bg-navy-950">
            <img src="/images/logo.svg" alt="Montclaire & Sterling Legal Logo" class="w-full h-full object-cover" width="44" height="44" loading="eager" decoding="async" />
          </div>
          <div class="min-w-0">
            <span class="block text-base sm:text-lg font-extrabold tracking-wider text-navy-950 uppercase font-sans leading-tight">
              MONTCLAIRE
            </span>
            <span class="block text-[8px] sm:text-[10px] tracking-widest text-gold-700 uppercase font-bold">
              & STERLING LEGAL
            </span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation Links (Centered) - Visible only on lg (1024px+) screens -->
      <nav class="hidden lg:flex items-center justify-center space-x-1 xl:space-x-2 shrink-0" aria-label="Main Navigation">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== `/${lang}/` && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                "h-9 px-3 xl:px-4 inline-flex items-center justify-center text-sm font-medium rounded-[2px] transition-all duration-200 whitespace-nowrap",
                isActive
                  ? "text-navy-950 bg-slate-100 border border-slate-300 font-semibold"
                  : "text-slate-700 hover:text-navy-950 hover:bg-slate-100/70"
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Action Area (Language + CTA) - Visible only on lg (1024px+) screens -->
      <div class="hidden lg:flex items-center justify-end gap-3 xl:gap-3.5 shrink-0">
        <LanguageSwitcher currentLang={lang} />

        <a
          href={`/${lang}/contact/`}
          class="relative min-w-[160px] h-10 xl:h-11 px-4 xl:px-5 shrink-0 inline-flex items-center justify-center text-xs xl:text-[13px] font-bold uppercase tracking-wider text-white rounded-[2px] bg-gradient-to-r from-gold-600 via-gold-500 to-gold-600 hover:from-gold-700 hover:to-gold-600 transition-all duration-300 shadow-sm hover:shadow-md active:scale-95 text-center whitespace-nowrap"
        >
          {t.nav.consultationBtn}
        </a>
      </div>

      <!-- Mobile & Tablet Controls (< 1024px) -->
      <div class="flex items-center gap-2 sm:gap-3 lg:hidden shrink-0">
        <!-- Show compact LanguageSwitcher in header on tablet screens (sm to lg) -->
        <div class="hidden sm:block">
          <LanguageSwitcher currentLang={lang} />
        </div>

        <button
          id="mobile-menu-toggle"
          type="button"
          class="p-2 sm:p-2.5 rounded-[2px] text-slate-700 hover:text-navy-900 hover:bg-slate-100 focus:outline-none border border-transparent hover:border-slate-200 transition-colors"
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile / Tablet Drawer Menu (< 1024px) -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-slate-200 bg-white/98 backdrop-blur-2xl shadow-2xl transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-5 space-y-4">
      
      <!-- Mobile Language Switcher Section (Visible on phones < sm) -->
      <div class="sm:hidden pb-3 border-b border-slate-100 flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500">
          {lang === 'th' ? 'เลือกภาษา' : lang === 'zh' ? '选择语言' : 'Language'}
        </span>
        <LanguageSwitcher currentLang={lang} />
      </div>

      <!-- Navigation Links -->
      <div class="space-y-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== `/${lang}/` && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                "block px-4 py-3 rounded-[2px] text-base font-semibold transition-colors",
                isActive
                  ? "text-navy-950 bg-slate-100 border-l-4 border-gold-600 pl-3 font-bold"
                  : "text-slate-800 hover:text-navy-950 hover:bg-slate-50"
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })}
      </div>

      <!-- Quick Consultation CTA Button in Drawer -->
      <div class="pt-2">
        <a
          href={`/${lang}/contact/`}
          class="block w-full text-center py-3.5 text-sm font-bold uppercase tracking-wider text-white rounded-[2px] bg-gradient-to-r from-gold-600 via-gold-500 to-gold-600 hover:from-gold-700 hover:to-gold-600 shadow-md active:scale-[0.99] transition-all"
        >
          {t.nav.consultationBtn}
        </a>
      </div>

    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.getElementById('hamburger-icon');
    const close = document.getElementById('close-icon');

    if (!toggleBtn || !menu) return;

    toggleBtn.addEventListener('click', () => {
      const isExpanded = !menu.classList.contains('hidden');
      if (isExpanded) {
        menu.classList.add('hidden');
        hamburger?.classList.remove('hidden');
        close?.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.remove('hidden');
        hamburger?.classList.add('hidden');
        close?.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupMobileMenu);
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
