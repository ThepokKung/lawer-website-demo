---
import { useTranslations, type SupportedLang } from '@/i18n';
import { SITE_CONFIG } from '@/config/site';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-gold-500/15 bg-navy-950/90 text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
      
      <!-- Column 1: Brand & Credibility -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-[2px] overflow-hidden border border-gold-500/40 shrink-0 bg-navy-900">
            <img src="/images/logo.svg" alt="Montclaire & Sterling Logo" class="w-full h-full object-cover" width="40" height="40" loading="lazy" decoding="async" />
          </div>
          <div>
            <span class="block text-base font-bold tracking-wider text-slate-100 uppercase">
              MONTCLAIRE & STERLING
            </span>
            <span class="block text-[10px] tracking-widest text-gold-400 uppercase">
              LEGAL COUNSEL
            </span>
          </div>
        </div>

        <p class="text-sm text-slate-300 leading-relaxed max-w-md">
          {t.brand.description}
        </p>

        <div class="text-xs text-slate-400 space-y-1 pt-2">
          <p class="flex items-start gap-2">
            <svg class="w-4 h-4 text-gold-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>{t.contact.addressValue}</span>
          </p>
        </div>
      </div>

      <!-- Column 2: Quick Links -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-gold-300">
          {t.footer.quickLinks}
        </h4>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`/${lang}/`} class="hover:text-gold-300 transition-colors">{t.nav.home}</a>
          </li>
          <li>
            <a href={`/${lang}/services/`} class="hover:text-gold-300 transition-colors">{t.nav.services}</a>
          </li>
          <li>
            <a href={`/${lang}/about/`} class="hover:text-gold-300 transition-colors">{t.nav.about}</a>
          </li>
          <li>
            <a href={`/${lang}/contact/`} class="hover:text-gold-300 transition-colors">{t.nav.contact}</a>
          </li>
          <li>
            <a href={`/${lang}/cookie-policy/`} class="hover:text-gold-300 transition-colors">{t.footer.cookiePolicy}</a>
          </li>
          <li>
            <a href={`/${lang}/privacy-policy/`} class="hover:text-gold-300 transition-colors">{t.footer.privacyPolicy}</a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Practice Areas -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-gold-300">
          {t.footer.practices}
        </h4>
        <ul class="space-y-2 text-sm">
          {t.services.map((service) => (
            <li>
              <a
                href={`/${lang}/services/${service.slug}/`}
                class="hover:text-gold-300 transition-colors line-clamp-1"
                title={service.title}
              >
                {service.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contact & Conversion Channels -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-gold-300">
          {t.footer.contactUs}
        </h4>
        <div class="space-y-2.5 text-sm">
          <a
            href={`tel:${t.contact.phoneValue.replace(/\s+/g, '')}`}
            class="track-call flex items-center gap-2 hover:text-gold-300 transition-colors"
            data-phone={t.contact.phoneValue}
          >
            <span class="w-7 h-7 rounded-[2px] bg-navy-900 border border-gold-500/20 flex items-center justify-center text-gold-400">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </span>
            <span>{t.contact.phoneValue}</span>
          </a>

          <a
            href={`mailto:${t.contact.emailValue}`}
            class="track-email flex items-center gap-2 hover:text-gold-300 transition-colors"
            data-email={t.contact.emailValue}
          >
            <span class="w-7 h-7 rounded-[2px] bg-navy-900 border border-gold-500/20 flex items-center justify-center text-gold-400">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </span>
            <span class="truncate">{t.contact.emailValue}</span>
          </a>

          <div class="pt-2 flex items-center gap-2">
            <!-- LINE CTA -->
            <a
              href={SITE_CONFIG.lineUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="track-line px-3 py-1.5 rounded-[2px] bg-[#06C755]/15 hover:bg-[#06C755]/25 border border-[#06C755]/40 text-[#06C755] text-xs font-semibold flex items-center gap-1.5 transition-all"
            >
              LINE: {t.contact.lineValue}
            </a>

            <!-- WeChat CTA -->
            <a
              href={`/${lang}/contact/#wechat`}
              class="track-wechat px-3 py-1.5 rounded-[2px] bg-[#07C160]/15 hover:bg-[#07C160]/25 border border-[#07C160]/40 text-[#07C160] text-xs font-semibold flex items-center gap-1.5 transition-all"
            >
              WeChat
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Legal Disclaimer -->
    <div class="mt-12 pt-8 border-t border-slate-800/80 text-xs text-slate-400 leading-relaxed">
      <p>{t.footer.disclaimer}</p>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-400 gap-4">
      <p>© {currentYear} {t.brand.legalName}. {t.footer.rights}.</p>
      <div class="flex items-center gap-6">
        <a href={`/${lang}/cookie-policy/`} class="hover:text-gold-300 transition-colors">{t.footer.cookiePolicy}</a>
        <a href={`/${lang}/privacy-policy/`} class="hover:text-gold-300 transition-colors">{t.footer.privacyPolicy}</a>
      </div>
    </div>
  </div>
</footer>

<script>
  import { trackEvent } from '@/utils/tracking';

  function attachFooterTracking() {
    document.querySelectorAll('.track-call').forEach((el) => {
      el.addEventListener('click', () => {
        const phone = el.getAttribute('data-phone') || '';
        trackEvent('click_call', { contact_method: 'phone', phone_number: phone });
      });
    });

    document.querySelectorAll('.track-email').forEach((el) => {
      el.addEventListener('click', () => {
        const email = el.getAttribute('data-email') || '';
        trackEvent('click_email', { contact_method: 'email', email_address: email });
      });
    });

    document.querySelectorAll('.track-line').forEach((el) => {
      el.addEventListener('click', () => {
        trackEvent('click_line', { channel: 'line', link_url: el.getAttribute('href') || '' });
      });
    });

    document.querySelectorAll('.track-wechat').forEach((el) => {
      el.addEventListener('click', () => {
        trackEvent('click_wechat', { channel: 'wechat' });
      });
    });

    document.querySelectorAll('.track-whatsapp').forEach((el) => {
      el.addEventListener('click', () => {
        trackEvent('click_whatsapp', { channel: 'whatsapp' });
      });
    });
  }

  document.addEventListener('astro:page-load', attachFooterTracking);
</script>
