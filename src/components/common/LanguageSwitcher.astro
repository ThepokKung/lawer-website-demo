---
import { getCleanPathWithoutLang, type SupportedLang } from '@/i18n';

interface Props {
  currentLang: SupportedLang;
}

const { currentLang } = Astro.props;
const currentPath = Astro.url.pathname;
const cleanPath = getCleanPathWithoutLang(currentPath);

const localesList: Array<{ code: SupportedLang; label: string; href: string }> = [
  {
    code: 'th',
    label: 'TH',
    href: `/th${cleanPath === '/' ? '' : cleanPath}`
  },
  {
    code: 'en',
    label: 'EN',
    href: `/en${cleanPath === '/' ? '' : cleanPath}`
  },
  {
    code: 'zh',
    label: '中文',
    href: `/zh${cleanPath === '/' ? '' : cleanPath}`
  }
];
---

<div class="inline-flex items-center p-1 rounded-full bg-navy-950/80 border border-gold-500/20 shadow-inner">
  {localesList.map((locale) => {
    const isActive = locale.code === currentLang;
    return (
      <a
        href={locale.href}
        data-from-lang={currentLang}
        data-to-lang={locale.code}
        class:list={[
          "lang-switch-btn px-2.5 py-1 text-xs font-medium rounded-full transition-all duration-300",
          isActive
            ? "bg-gradient-to-r from-gold-500 to-gold-400 text-navy-950 font-bold shadow-sm"
            : "text-slate-400 hover:text-slate-200 hover:bg-slate-800/40"
        ]}
        aria-current={isActive ? "page" : undefined}
      >
        {locale.label}
      </a>
    );
  })}
</div>

<script>
  import { trackLanguageSwitch } from '@/utils/tracking';

  function setupLangSwitchTracking() {
    document.querySelectorAll('.lang-switch-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const fromLang = target.getAttribute('data-from-lang') || 'th';
        const toLang = target.getAttribute('data-to-lang') || 'th';
        if (fromLang !== toLang) {
          trackLanguageSwitch(fromLang, toLang);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupLangSwitchTracking);
  document.addEventListener('astro:page-load', setupLangSwitchTracking);
</script>
