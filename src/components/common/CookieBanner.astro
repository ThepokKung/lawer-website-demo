---
interface Props {
  lang?: 'th' | 'en' | 'zh';
}

const { lang = 'th' } = Astro.props;

const content = {
  th: {
    title: "การคุ้มครองข้อมูลส่วนบุคคลและคุกกี้ (PDPA)",
    desc: "เว็บไซต์ของเราใช้คุกกี้ที่จำเป็นสำหรับการทำงานขั้นพื้นฐาน และคุกกี้เพื่อการวิเคราะห์และพัฒนาประสบการณ์การใช้งานของท่าน ท่านสามารถเลือกจัดการการตั้งค่าได้ตามต้องการ",
    acceptAll: "ยอมรับทั้งหมด",
    decline: "ปฏิเสธคุกกี้ที่ไม่จำเป็น",
    policy: "การตั้งค่าคุกกี้",
    policyHref: "/th/cookie-policy"
  },
  en: {
    title: "Privacy & Cookie Preferences",
    desc: "Our website uses necessary cookies for core functionality and cookies to evaluate site usage to enhance your experience. You may customize your preferences at any time.",
    acceptAll: "Accept All",
    decline: "Decline Non-Essential",
    policy: "Cookie Settings",
    policyHref: "/en/cookie-policy"
  },
  zh: {
    title: "隐私与 Cookie 偏好设置",
    desc: "本网站使用必要的系统 Cookie 以及用于评估与改进浏览体验的分析类 Cookie。您可以随时自定义偏好设置。",
    acceptAll: "全部接受",
    decline: "拒绝非必要",
    policy: "Cookie 设置",
    policyHref: "/zh/cookie-policy"
  }
}[lang];
---

<aside
  id="ms-cookie-banner"
  role="dialog"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-desc"
  class="fixed bottom-6 left-4 right-4 md:left-auto md:right-8 md:max-w-xl z-50 transition-all duration-500 transform translate-y-32 opacity-0 pointer-events-none"
>
  <div class="glass-card rounded-[2px] p-5 md:p-6 shadow-2xl border border-slate-300 bg-white text-slate-800">
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400 shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5" />
          <path d="M8.5 8.5v.01" />
          <path d="M16 15.5v.01" />
          <path d="M12 12v.01" />
          <path d="M11 17v.01" />
          <path d="M7 13v.01" />
        </svg>
      </div>

      <div class="space-y-1.5">
        <h3 id="cookie-banner-title" class="font-bold text-base text-navy-950">
          {content.title}
        </h3>
        <p id="cookie-banner-desc" class="text-xs md:text-sm text-slate-600 leading-relaxed">
          {content.desc}
        </p>
      </div>
    </div>

    <div class="mt-5 pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3">
      <a
        href={content.policyHref}
        class="text-xs font-semibold text-navy-900 hover:text-gold-700 underline underline-offset-4 transition-colors"
      >
        {content.policy}
      </a>

      <div class="flex items-center gap-2.5 ml-auto">
        <button
          type="button"
          id="btn-cookie-decline"
          class="px-4 py-2 rounded-[2px] text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-navy-950 bg-slate-100 hover:bg-slate-200 border border-slate-300 transition-all active:scale-95"
        >
          {content.decline}
        </button>
        <button
          type="button"
          id="btn-cookie-accept-all"
          class="px-4 py-2 rounded-[2px] text-xs font-bold uppercase tracking-wider text-white bg-navy-900 hover:bg-gold-600 shadow-sm transition-all active:scale-95"
        >
          {content.acceptAll}
        </button>
      </div>
    </div>
  </div>
</aside>

<script>
  import { getStoredConsent, saveConsent } from '@/utils/consent';

  function initCookieBanner() {
    const banner = document.getElementById('ms-cookie-banner');
    const btnAccept = document.getElementById('btn-cookie-accept-all');
    const btnDecline = document.getElementById('btn-cookie-decline');

    if (!banner) return;

    const stored = getStoredConsent();
    if (!stored) {
      setTimeout(() => {
        banner.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
      }, 1000);
    }

    btnAccept?.addEventListener('click', () => {
      saveConsent(true, true);
      hideBanner();
    });

    btnDecline?.addEventListener('click', () => {
      saveConsent(false, false);
      hideBanner();
    });

    function hideBanner() {
      banner?.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
    }
  }

  document.addEventListener('DOMContentLoaded', initCookieBanner);
  document.addEventListener('astro:page-load', initCookieBanner);
</script>
