---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';
import ContactChannels from '@/components/contact/ContactChannels.astro';
import ConsultationForm from '@/components/contact/ConsultationForm.astro';
import { useTranslations, type SupportedLang } from '@/i18n';
import { SITE_CONFIG } from '@/config/site';

export function getStaticPaths() {
  return [
    { params: { lang: 'th' } },
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params as { lang: SupportedLang };
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t.contact.title} | ${t.brand.name}`}
  description={`${t.contact.subtitle} - ${t.brand.legalName}`}
  lang={lang}
>
  <Navbar lang={lang} />

  <main class="pt-12 pb-24">
    <!-- Header Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
      <div class="reveal-init inline-block px-3.5 py-1.5 rounded-[2px] bg-gold-100 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider mb-5 sm:mb-6">
        {t.contact.sectionBadge}
      </div>
      <h1 class="reveal-init stagger-1 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-navy-950 tracking-tight leading-[1.3] sm:leading-[1.25] mb-6">
        {t.contact.title}
      </h1>
      <p class="reveal-init stagger-2 max-w-2xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed">
        {t.contact.subtitle}
      </p>
    </div>

    <!-- Contact Content Layout -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Channels & Location (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          <ContactChannels lang={lang} />

          <!-- Location Map Card -->
          <div class="reveal-init rounded-[2px] p-6 bg-white border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center justify-between">
              <h4 class="text-sm font-bold text-navy-950 flex items-center gap-2">
                <svg class="w-4 h-4 text-gold-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
                <span>{lang === 'th' ? 'แผนที่และการเดินทาง' : lang === 'zh' ? '交通路线与地理位置' : 'Location & Directions'}</span>
              </h4>
              <span class="text-[11px] font-semibold text-gold-700 bg-gold-400/10 px-2 py-0.5 rounded-[2px] border border-gold-500/20">
                BTS ช่องนนทรี (Chong Nonsi)
              </span>
            </div>

            <!-- Interactive Google Map Embed -->
            <div class="w-full h-72 sm:h-80 rounded-[2px] overflow-hidden border border-slate-300 bg-slate-100 shadow-inner relative">
              <iframe
                src={SITE_CONFIG.mapsEmbedUrl}
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Google Maps Location - Montclaire & Sterling Legal Counsel"
                class="w-full h-full"
              ></iframe>
            </div>

            <div class="space-y-2 pt-1 text-xs text-slate-600">
              <p class="font-bold text-navy-950 flex items-start gap-2">
                <svg class="w-4 h-4 text-gold-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{t.contact.addressValue}</span>
              </p>
              <p class="flex items-center gap-2 text-slate-500">
                <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                </svg>
                <span>BTS ช่องนนทรี ทางออก 1 (มีทางเชื่อม Skywalk สู่ชั้น 2 ของอาคารโดยตรง)</span>
              </p>
            </div>

            <a
              href={SITE_CONFIG.mapsDirectUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 w-full py-3.5 px-6 rounded-[2px] text-sm font-bold uppercase tracking-wider text-white bg-navy-900 hover:bg-gold-600 border border-gold-500/30 shadow-sm hover:shadow-md transition-all active:scale-[0.98]"
            >
              <svg class="w-3.5 h-3.5 text-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <polygon points="3 11 22 2 13 21 11 13 3 11" />
              </svg>
              <span>{lang === 'th' ? 'เปิดนำทางด้วย Google Maps' : lang === 'zh' ? '在谷歌地图中开启导航' : 'Get Directions on Google Maps'}</span>
            </a>
          </div>
        </div>

        <!-- Consultation Form (7 cols) -->
        <div class="lg:col-span-7">
          <ConsultationForm lang={lang} />
        </div>

      </div>
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>
