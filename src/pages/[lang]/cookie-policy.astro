---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';
import { useTranslations, type SupportedLang } from '@/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'th' } },
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params as { lang: SupportedLang };
const t = useTranslations(lang);

const policyContent = {
  th: {
    pageTitle: "นโยบายการใช้คุกกี้",
    settingsTitle: "การตั้งค่าคุกกี้ขั้นสูง (Advanced Cookie Settings)",
    necessaryDesc: "คุกกี้เหล่านี้ช่วยให้เว็บไซต์สามารถทำงานพื้นฐานได้อย่างถูกต้อง เช่น ความปลอดภัย การยืนยันตัวตน และการจัดการเครือข่าย คุกกี้เหล่านี้ไม่สามารถปิดใช้งานได้",
    marketingTitle: "เปิดใช้งานคุกกี้เพื่อการตลาด (Enable Marketing Cookies)",
    marketingDesc: "คุกกี้เหล่านี้ใช้ในการติดตามประสิทธิผลของการโฆษณา เพื่อให้บริการที่ตรงกับความต้องการและนำเสนอข้อมูลที่เหมาะสมกับความสนใจของท่าน",
    functionalTitle: "เปิดใช้งานคุกกี้เพื่อการทำงานของเว็บไซต์ (Enable Functional Cookies)",
    functionalDesc: "คุกกี้เหล่านี้รวบรวมข้อมูลเพื่อจดจำตัวเลือกที่ผู้ใช้กำหนด เพื่อปรับปรุงและมอบประสบการณ์การใช้งานที่ตรงตามความต้องการเฉพาะบุคคล",
    analyticsTitle: "เปิดใช้งานคุกกี้เพื่อการวิเคราะห์ (Enable Analytics Cookies)",
    analyticsDesc: "คุกกี้เหล่านี้ช่วยให้เราเข้าใจปฏิสัมพันธ์ของผู้เข้าชมกับเว็บไซต์ ค้นหาข้อผิดพลาด และพัฒนาการวิเคราะห์ภาพรวมของเว็บไซต์ให้ดียิ่งขึ้น",
    saveBtn: "บันทึก",
    savedAlert: "บันทึกการตั้งค่าคุกกี้ของท่านเรียบร้อยแล้ว"
  },
  en: {
    pageTitle: "Cookie Policy",
    settingsTitle: "Advanced Cookie Settings",
    necessaryDesc: "These cookies enable core functionality such as security, verification of identity and network management. These cookies can't be disabled.",
    marketingTitle: "Enable Marketing Cookies",
    marketingDesc: "These cookies are used to track advertising effectiveness to provide a more relevant service and deliver better ads to suit your interests.",
    functionalTitle: "Enable Functional Cookies",
    functionalDesc: "These cookies collect data to remember choices users make to improve and give a more personalised experience.",
    analyticsTitle: "Enable Analytics Cookies",
    analyticsDesc: "These cookies help us to understand how visitors interact with our website, discover errors and provide a better overall analytics.",
    saveBtn: "Save",
    savedAlert: "Your cookie settings have been saved successfully."
  },
  zh: {
    pageTitle: "Cookie 政策说明",
    settingsTitle: "高级 Cookie 设置 (Advanced Cookie Settings)",
    necessaryDesc: "此类 Cookie 用于实现网站核心功能，如安全性、身份验证及网络管理，无法禁用。",
    marketingTitle: "启用营销推广 Cookie (Enable Marketing Cookies)",
    marketingDesc: "此类 Cookie 用于衡量广告宣传成效，以提供更贴合您需求的服务并呈现符合您兴趣的内容。",
    functionalTitle: "启用功能性 Cookie (Enable Functional Cookies)",
    functionalDesc: "此类 Cookie 用于记录并记忆用户的偏好设置，以优化并提供更加个性化的浏览体验。",
    analyticsTitle: "启用数据分析 Cookie (Enable Analytics Cookies)",
    analyticsDesc: "此类 Cookie 帮助我们了解访客与网站的互动情况、发现错误并提供更完善的综合数据分析。",
    saveBtn: "保存",
    savedAlert: "您的 Cookie 设置已成功保存。"
  }
}[lang];
---

<BaseLayout
  title={`${policyContent.pageTitle} | ${t.brand.name}`}
  description={policyContent.necessaryDesc}
  lang={lang}
>
  <Navbar lang={lang} />

  <main class="pt-12 pb-24 bg-slate-50">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      
      <!-- Page Breadcrumb / Mini Header -->
      <div class="mb-8 text-center sm:text-left">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-navy-950 tracking-tight">
          {policyContent.pageTitle}
        </h1>
        <p class="text-xs text-slate-500 mt-1">
          {t.brand.legalName}
        </p>
      </div>

      <!-- Advanced Cookie Settings Card (Exact match to reference) -->
      <div class="rounded-[2px] bg-white border border-slate-300 shadow-sm overflow-hidden">
        
        <!-- Header Section -->
        <div class="p-6 sm:p-8 border-b border-slate-200">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-3">
            {policyContent.settingsTitle}
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-2xl">
            {policyContent.necessaryDesc}
          </p>
        </div>

        <!-- Success Notification -->
        <div id="consent-saved-alert" class="hidden mx-6 sm:mx-8 mt-6 p-3.5 rounded-[2px] bg-emerald-50 border border-emerald-300 text-emerald-900 text-xs sm:text-sm font-medium flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          <span>{policyContent.savedAlert}</span>
        </div>

        <!-- Cookie Categories List -->
        <div class="divide-y divide-slate-200">
          
          <!-- Marketing Cookies -->
          <div class="p-6 sm:p-8 flex items-start justify-between gap-6 hover:bg-slate-50/50 transition-colors">
            <div class="space-y-1.5 max-w-xl">
              <h3 class="text-sm sm:text-base font-semibold text-slate-900">
                {policyContent.marketingTitle}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {policyContent.marketingDesc}
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" id="toggle-marketing" class="sr-only peer" />
              <div class="w-12 h-7 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-navy-900"></div>
            </label>
          </div>

          <!-- Functional Cookies -->
          <div class="p-6 sm:p-8 flex items-start justify-between gap-6 hover:bg-slate-50/50 transition-colors">
            <div class="space-y-1.5 max-w-xl">
              <h3 class="text-sm sm:text-base font-semibold text-slate-900">
                {policyContent.functionalTitle}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {policyContent.functionalDesc}
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" id="toggle-functional" class="sr-only peer" checked />
              <div class="w-12 h-7 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-navy-900"></div>
            </label>
          </div>

          <!-- Analytics Cookies -->
          <div class="p-6 sm:p-8 flex items-start justify-between gap-6 hover:bg-slate-50/50 transition-colors">
            <div class="space-y-1.5 max-w-xl">
              <h3 class="text-sm sm:text-base font-semibold text-slate-900">
                {policyContent.analyticsTitle}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {policyContent.analyticsDesc}
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0 mt-1">
              <input type="checkbox" id="toggle-analytics" class="sr-only peer" />
              <div class="w-12 h-7 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-6 after:w-6 after:transition-all peer-checked:bg-navy-900"></div>
            </label>
          </div>

        </div>

        <!-- Footer / Action Area -->
        <div class="p-6 sm:p-8 bg-slate-50/70 border-t border-slate-200 flex items-center justify-end">
          <button
            type="button"
            id="btn-save-preferences"
            class="min-w-[130px] px-9 py-3.5 rounded-[2px] text-sm font-bold uppercase tracking-wider text-white bg-black hover:bg-navy-900 transition-all active:scale-[0.98] shadow-sm"
          >
            {policyContent.saveBtn}
          </button>
        </div>

      </div>

    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<script>
  import { getStoredConsent, saveConsent } from '@/utils/consent';

  function initCookieSettings() {
    const toggleMarketing = document.getElementById('toggle-marketing') as HTMLInputElement | null;
    const toggleFunctional = document.getElementById('toggle-functional') as HTMLInputElement | null;
    const toggleAnalytics = document.getElementById('toggle-analytics') as HTMLInputElement | null;
    const btnSave = document.getElementById('btn-save-preferences');
    const alertBox = document.getElementById('consent-saved-alert');

    if (!toggleMarketing || !toggleFunctional || !toggleAnalytics || !btnSave) return;

    // Load stored values
    const current = getStoredConsent();
    if (current) {
      toggleMarketing.checked = !!current.marketing;
      toggleFunctional.checked = current.functional !== false;
      toggleAnalytics.checked = !!current.analytics;
    } else {
      toggleMarketing.checked = false;
      toggleFunctional.checked = true;
      toggleAnalytics.checked = false;
    }

    btnSave.addEventListener('click', () => {
      saveConsent(toggleAnalytics.checked, toggleMarketing.checked, toggleFunctional.checked);
      alertBox?.classList.remove('hidden');
      setTimeout(() => {
        alertBox?.classList.add('hidden');
      }, 4000);
    });
  }

  document.addEventListener('DOMContentLoaded', initCookieSettings);
  document.addEventListener('astro:page-load', initCookieSettings);
</script>
