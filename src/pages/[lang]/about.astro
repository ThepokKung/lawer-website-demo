---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';
import HomeCta from '@/components/home/HomeCta.astro';
import { useTranslations, type SupportedLang } from '@/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'th' } },
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params as { lang: SupportedLang };
const t = useTranslations(lang);

const ethics = {
  th: [
    { title: "ซื่อสัตย์สุจริตและโปร่งใส", desc: "ยึดมั่นในความจริง ชี้แจงข้อดีข้อเสียของคดีอย่างตรงไปตรงมา ไม่ให้ความหวังที่เกินจริงแก่ลูกความ" },
    { title: "รักษาความลับตามมรรยาทวิชาชีพ", desc: "ข้อมูลลูกความทุกชิ้นได้รับการจัดเก็บด้วยระบบความปลอดภัยระดับสถาบันการเงิน และได้รับการคุ้มครองสิทธิการไม่เปิดเผยความลับของทนายความ" },
    { title: "ความมุ่งมั่นเพื่อผลสัมฤทธิ์สูงสุด", desc: "ทุ่มเทค้นคว้าแนวคำพิพากษาฎีกา ประมวลกฎหมาย และกลยุทธ์การว่าความในทุกมิติเพื่อปกป้องสิทธิประโยชน์ของท่าน" }
  ],
  en: [
    { title: "Unyielding Integrity & Candor", desc: "We provide honest, unvarnished legal risk appraisals without false assurances or inflated promises." },
    { title: "Sacrosanct Professional Privilege", desc: "Client data is safeguarded with institutional-grade encryption protocols and backed by strict statutory privilege." },
    { title: "Relentless Commitment to Excellence", desc: "We exhaustively research legal precedents and design trial strategy to deliver definitive commercial victories." }
  ],
  zh: [
    { title: "恪守诚信与客观研判", desc: "如实陈述案件事实与法律依据，客观剖析胜诉面与潜在风险，绝不对委托人作出虚假承诺。" },
    { title: "顶级保密机制与特权保护", desc: "全案档案与通讯均纳入律师法定保密特权范围，采用银行级严密数字加密与物理隔离存储。" },
    { title: "精益求精的制胜追求", desc: "深度穷尽判例检索与成文法法理，全方位推演攻防棋局，力求为委托人赢得最佳商业结果。" }
  ]
}[lang];
---

<BaseLayout
  title={`${t.nav.about} | ${t.brand.name}`}
  description={`${t.brand.description}`}
  lang={lang}
>
  <Navbar lang={lang} />

  <main class="pt-12 pb-24">
    <!-- Header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
      <div class="reveal-init inline-block px-3.5 py-1.5 rounded-[2px] bg-gold-100 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider mb-5 sm:mb-6">
        {t.teamSection.sectionBadge}
      </div>
      <h1 class="reveal-init stagger-1 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-navy-950 tracking-tight leading-[1.3] sm:leading-[1.25] mb-6 break-words">
        {t.brand.name}
      </h1>
      <p class="reveal-init stagger-2 max-w-3xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed">
        {t.brand.description}
      </p>
    </div>

    <!-- Firm Pedigree Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="rounded-[2px] p-8 sm:p-12 lg:p-16 border border-slate-200 bg-white shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div class="space-y-6">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-950 leading-tight">
              {lang === 'th' ? 'กว่าสองทศวรรษแห่งการเป็นเกราะป้องกันทางกฎหมาย' : lang === 'zh' ? '逾二十载矢志不渝的泰方法律护航壁垒' : 'Over Two Decades of Uncompromising Legal Advocacy'}
            </h2>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              {lang === 'th'
                ? 'สำนักงานกฎหมาย มงต์แคลร์ แอนด์ สเตอร์ลิง ก่อตั้งขึ้นด้วยวิสัยทัศน์ที่ต้องการยกระดับมาตรฐานการให้บริการทางกฎหมายในประเทศไทยให้ทัดเทียมสากล เราให้บริการทั้งแก่องค์กรธุรกิจชั้นนำ บริษัทข้ามชาติ และบุคคลทั่วไป ด้วยความเชี่ยวชาญเฉพาะทางในแต่ละสาขากฎหมาย'
                : lang === 'zh'
                ? '蒙克莱尔·斯特林律所（Montclaire & Sterling）自创立以来，始终立足曼谷商业核心，致力于消除外资企业与本地法律制度之间的沟通鸿沟与风控盲区。我们以极高的职业胜诉率和商业信誉，成为众多跨国集团进军泰国的首选法务军师。'
                : 'Founded in 2004, Montclaire & Sterling was forged with a singular mission: to deliver international-tier legal precision within Thailand’s evolving statutory environment. We have represented Fortune 500 multinationals, innovative private enterprises, and prominent families across critical junctures.'}
            </p>

            <!-- Boardroom Photo -->
            <div class="rounded-[2px] overflow-hidden border border-slate-200 shadow-sm relative group">
              <img
                src="/images/office-boardroom.jpg"
                alt="Montclaire & Sterling Sathorn Headquarters Boardroom"
                class="w-full h-56 object-cover filter brightness-[1.02] contrast-[1.02] group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                decoding="async"
                width="600"
                height="300"
              />
              <div class="absolute bottom-2 left-2 px-2.5 py-1 rounded-[2px] bg-navy-950/80 backdrop-blur-md text-[11px] text-white font-medium border border-white/10 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-gold-400"></span>
                <span>Sathorn Square Tower 28th Fl. Executive Suite</span>
              </div>
            </div>
          </div>

          <!-- Ethics Box -->
          <div class="space-y-4">
            {ethics.map((item, i) => (
              <div class="p-5 rounded-[2px] bg-slate-50 border border-slate-200 hover:border-gold-500 transition-colors">
                <h3 class="text-base font-bold text-navy-950 mb-1">
                  <span class="text-gold-600 mr-1.5 font-mono">0{i + 1}.</span>
                  {item.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Detailed Partner Roster -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="text-center max-w-2xl mx-auto mb-14">
        <h2 class="reveal-init text-3xl sm:text-4xl font-extrabold text-navy-950 leading-[1.3] sm:leading-[1.25] mb-4 sm:mb-5">
          {t.teamSection.title}
        </h2>
        <p class="reveal-init stagger-1 text-sm sm:text-base text-slate-600">
          {t.teamSection.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {t.teamSection.members.map((member, idx) => (
          <div class:list={["reveal-init rounded-[2px] p-6 sm:p-8 flex flex-col justify-between bg-white border border-slate-200/90 shadow-sm glass-card-hover", `stagger-${idx + 1}`]}>
            <div>
              <!-- Sharp Real Attorney Photo -->
              <div class="relative w-full aspect-[4/3] rounded-[2px] overflow-hidden border border-slate-200 mb-6 shadow-xs group/photo bg-slate-100">
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover object-top filter brightness-[1.02] contrast-[1.02] group-hover/photo:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                  width="400"
                  height="300"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/20 via-transparent to-transparent pointer-events-none"></div>
              </div>

              <h3 class="text-xl font-bold text-navy-950 mb-1">{member.name}</h3>
              <p class="text-xs font-bold uppercase tracking-wider text-gold-700 mb-4 min-h-[32px] flex items-center">{member.role}</p>

              <div class="p-3.5 rounded-[2px] bg-slate-100/90 border border-slate-200/90 text-xs text-slate-700 mb-4 min-h-[64px] flex items-center leading-relaxed">
                {member.credentials}
              </div>

              <p class="text-sm text-slate-600 leading-relaxed min-h-[72px]">
                {member.experience}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-slate-100">
              <a
                href={`/${lang}/contact/?attorney=${encodeURIComponent(member.name)}`}
                class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-navy-900 hover:text-gold-700 transition-colors"
              >
                <span>{t.contact.formTitle}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Accreditations & Memberships -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="reveal-init rounded-[2px] p-8 border border-slate-200 bg-white text-center shadow-xs">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gold-800 mb-6">
          {lang === 'th' ? 'การรับรองและสมาชิกภาพองค์กรวิชาชีพกฎหมาย' : lang === 'zh' ? '官方律师执业认证与国际仲裁公会资质' : 'Professional Accreditations & Bar Affiliations'}
        </h3>
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs sm:text-sm text-slate-700 font-medium">
          <span class="px-4 py-2.5 rounded-[2px] bg-slate-50 border border-slate-200">สภาทนายความแห่งประเทศไทย (Lawyers Council)</span>
          <span class="px-4 py-2.5 rounded-[2px] bg-slate-50 border border-slate-200">สำนักอบรมศึกษากฎหมายแห่งเนติบัณฑิตยสภา (Thai Bar)</span>
          <span class="px-4 py-2.5 rounded-[2px] bg-slate-50 border border-slate-200">ทนายความผู้ทำคำรับรองลายมือชื่อ (Notarial Attorney)</span>
          <span class="px-4 py-2.5 rounded-[2px] bg-slate-50 border border-slate-200">International Bar Association (IBA)</span>
        </div>
      </div>
    </section>

    <HomeCta lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
