---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';
import HomeCta from '@/components/home/HomeCta.astro';
import ClientsShowcase from '@/components/home/ClientsShowcase.astro';
import { useTranslations, type SupportedLang } from '@/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'th' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as { lang: SupportedLang };
const t = useTranslations(lang);

const ethics = {
  th: [
    { title: "ซื่อสัตย์สุจริตและโปร่งใส", desc: "ยึดมั่นในความจริง ชี้แจงข้อดีข้อเสียของคดีอย่างตรงไปตรงมา ไม่ให้ความหวังที่เกินจริงแก่ลูกความ" },
    { title: "รักษาความลับตามมรรยาทวิชาชีพ", desc: "ข้อมูลลูกความทุกชิ้นได้รับการจัดเก็บด้วยระบบความปลอดภัยระดับสถาบันการเงิน และได้รับการคุ้มครองสิทธิการไม่เปิดเผยความลับของทนายความ" },
    { title: "ความมุ่งมั่นเพื่อผลสัมฤทธิ์สูงสุด", desc: "ทุ่มเทค้นคว้าแนวคำพิพากษาฎีกา ประมวลกฎหมาย และกลยุทธ์การว่าความในทุกมิติเพื่อปกป้องสิทธิประโยชน์ของท่าน" }
  ],
  en: [
    { title: "Unyielding Integrity & Candor", desc: "We provide honest, unvarnished legal risk appraisals without false assurances or inflated promises." },
    { title: "Sacrosanct Professional Privilege", desc: "Client data is safeguarded with institutional-grade encryption protocols and backed by strict statutory privilege." },
    { title: "Relentless Commitment to Excellence", desc: "We exhaustively research legal precedents and design trial strategy to deliver definitive commercial victories." }
  ]
}[lang];
---

<BaseLayout
  title={`${t.nav.about} | ${t.brand.name}`}
  description={`${t.brand.description}`}
  lang={lang}
>
  <Navbar lang={lang} />

  <main class="pt-12 pb-24">
    <!-- Header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
      <div class="reveal-init inline-block px-3.5 py-1.5 rounded-[2px] bg-gold-100 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider mb-5 sm:mb-6">
        {t.teamSection.sectionBadge}
      </div>
      <h1 class="reveal-init stagger-1 text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-navy-950 tracking-tight leading-[1.3] sm:leading-[1.25] mb-6 break-words">
        {t.brand.name}
      </h1>
      <p class="reveal-init stagger-2 max-w-3xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed">
        {t.brand.description}
      </p>
    </div>

    <!-- Firm Pedigree Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="rounded-[2px] p-8 sm:p-12 lg:p-16 border border-slate-200 bg-white shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div class="space-y-6">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-950 leading-tight">
              {lang === 'th' ? 'มุ่งมั่นในการให้บริการด้านกฎหมายที่ครบวงจรและเป็นเลิศ' : 'Dedicated to Comprehensive & Practical Legal Protection'}
            </h2>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              {lang === 'th'
                ? 'บริษัท ธันปรัท ทนายความ จำกัด ก่อตั้งขึ้นในปี พ.ศ. 2561 ด้วยปณิธานอันแน่วแน่ในการเป็นที่พึ่งพาด้านกฎหมายให้แก่องค์กรธุรกิจและบุคคลทั่วไป โดยยึดมั่นในหลักความซื่อสัตย์ ความโปร่งใส และการสร้างความสำเร็จร่วมกันกับลูกค้า ภายใต้การนำของ คุณปรัชญา วิชาโคตร ผู้มีประสบการณ์ว่าความและที่ปรึกษากฎหมายมากว่า 26 ปี'
                : 'Established in 2018, THANPRAT LAWYER CO., LTD. is a premier boutique Thai law firm based in Dusit, Bangkok. Founded by Managing Director Pratchaya Vichakote (practicing since 2000), our team protects clients’ interests with uncompromising integrity, legal precision, and proactive risk mitigation.'}
            </p>
          </div>

          <div class="space-y-4">
            <div class="p-6 rounded-[2px] bg-slate-50 border border-slate-200">
              <div class="text-2xl sm:text-3xl font-bold font-serif text-gold-700 mb-1">
                {lang === 'th' ? '2561' : '2018'}
              </div>
              <div class="text-xs sm:text-sm font-semibold text-slate-800">
                {lang === 'th' ? 'ปีที่ก่อตั้งสำนักงาน' : 'Year Established'}
              </div>
              <div class="text-xs text-slate-500 mt-1">
                {lang === 'th' ? 'จดทะเบียนนิติบุคคลตามกฎหมายไทยอย่างเป็นทางการ (พ.ศ. 2561)' : 'Officially incorporated under the Department of Business Development'}
              </div>
            </div>

            <div class="p-6 rounded-[2px] bg-slate-50 border border-slate-200">
              <div class="text-2xl sm:text-3xl font-bold font-serif text-gold-700 mb-1">26+</div>
              <div class="text-xs sm:text-sm font-semibold text-slate-800">
                {lang === 'th' ? 'ปีแห่งประสบการณ์ทางวิชาชีพ' : 'Years of Combined Practice Leadership'}
              </div>
              <div class="text-xs text-slate-500 mt-1">
                {lang === 'th' ? 'หัวหน้าสำนักงานเริ่มต้นงานวิชาชีพกฎหมายตั้งแต่ปี พ.ศ. 2543' : 'Managing Director practicing law and corporate advisory since 2000'}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Ethics & Philosophy -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-950">
          {lang === 'th' ? 'หลักจรรยาบรรณและมาตรฐานการทำงาน' : 'Our Professional Tenets & Integrity'}
        </h2>
        <div class="w-12 h-0.5 bg-gold-600 mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {ethics.map((item, idx) => (
          <div class="reveal-init rounded-[2px] p-6 sm:p-8 border border-slate-200 bg-white hover:border-gold-500/50 hover:shadow-md transition-all">
            <div class="text-xs font-bold text-gold-700 mb-2">0{idx + 1}</div>
            <h3 class="text-lg font-bold text-navy-950 mb-3">{item.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Leadership & Key Attorneys -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-gold-800">
          {t.teamSection.sectionBadge}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-950 mt-2">
          {t.teamSection.title}
        </h2>
        <div class="w-12 h-0.5 bg-gold-600 mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {t.teamSection.members.map((member) => (
          <div class="reveal-init group rounded-[2px] p-6 border border-slate-200 bg-white hover:border-gold-500/50 hover:shadow-lg transition-all duration-300 flex flex-col justify-between">
            <div>
              <a href={`/${lang}/team/${member.slug}/`} class="block relative aspect-4/5 w-full mb-5 overflow-hidden rounded-[2px] bg-navy-950">
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  width="400"
                  height="500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
              </a>

              <h3 class="text-lg font-bold text-navy-950 mb-1 leading-snug">
                <a href={`/${lang}/team/${member.slug}/`} class="hover:text-gold-700 transition-colors">
                  {member.name}
                </a>
              </h3>

              <p class="text-xs font-bold uppercase tracking-wider text-gold-700 mb-3 min-h-[32px] flex items-center">
                {member.role}
              </p>

              <div class="p-3 rounded-[2px] bg-slate-100/90 border border-slate-200/90 text-xs text-slate-700 mb-3 min-h-[72px] flex items-center leading-relaxed">
                {member.credentials}
              </div>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed min-h-[72px]">
                {member.experience}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between gap-2">
              <a
                href={`/${lang}/team/${member.slug}/`}
                class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-navy-900 hover:text-gold-700 transition-colors group/link"
              >
                <span>{lang === 'th' ? 'ดูประวัติเต็ม' : 'View Profile'}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 ml-1 transform group-hover/link:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>

              <a
                href={`/${lang}/contact/?attorney=${encodeURIComponent(member.name)}`}
                class="text-xs font-semibold text-gold-700 hover:text-navy-950 transition-colors shrink-0"
              >
                {lang === 'th' ? 'เข้ารับการปรึกษา' : 'Consultation'}
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Accreditations & Memberships -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="reveal-init rounded-[2px] p-8 border border-slate-200 bg-white text-center shadow-xs">
        <h3 class="text-xs font-bold uppercase tracking-wider text-gold-800 mb-6">
          {lang === 'th' ? 'การรับรองและสมาชิกภาพองค์กรวิชาชีพกฎหมาย' : 'Professional Accreditations & Bar Affiliations'}
        </h3>
        <div class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs sm:text-sm text-slate-700 font-medium">
          <span class="px-4 py-2.5 rounded-[2px] bg-slate-50 border border-slate-200">
            {lang === 'th' ? 'สภาทนายความในพระบรมราชูปถัมภ์' : 'Lawyers Council of Thailand'}
          </span>
          <span class="px-4 py-2.5 rounded-[2px] bg-slate-50 border border-slate-200">
            {lang === 'th' ? 'สำนักอบรมศึกษากฎหมายแห่งเนติบัณฑิตยสภา' : 'Thai Bar Association'}
          </span>
          <span class="px-4 py-2.5 rounded-[2px] bg-slate-50 border border-slate-200">
            {lang === 'th' ? 'ทนายความผู้ทำคำรับรองลายมือชื่อและเอกสาร' : 'Certified Notarial Services Attorney'}
          </span>
          <span class="px-4 py-2.5 rounded-[2px] bg-slate-50 border border-slate-200">
            {lang === 'th' ? 'สมาคมทนายความระหว่างประเทศ (IBA)' : 'International Bar Association (IBA)'}
          </span>
        </div>
      </div>
    </section>

    <ClientsShowcase lang={lang} />

    <HomeCta lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
