---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';
import HomeCta from '@/components/home/HomeCta.astro';
import { useTranslations, type SupportedLang } from '@/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'th' } },
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const { lang } = Astro.params as { lang: SupportedLang };
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t.servicesSection.title} | ${t.brand.name}`}
  description={`${t.servicesSection.subtitle} - ${t.brand.legalName}`}
  lang={lang}
>
  <Navbar lang={lang} />

  <main class="pt-12 pb-24">
    <!-- Header Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
      <div class="reveal-init inline-block px-3.5 py-1.5 rounded-[2px] bg-gold-100 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider mb-5 sm:mb-6">
        {t.servicesSection.sectionBadge}
      </div>
      <h1 class="reveal-init stagger-1 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-navy-950 tracking-tight leading-[1.3] sm:leading-[1.25] mb-6">
        {t.servicesSection.title}
      </h1>
      <p class="reveal-init stagger-2 max-w-3xl mx-auto text-base sm:text-lg text-slate-600 leading-relaxed">
        {t.servicesSection.subtitle}
      </p>
    </div>

    <!-- Practice Areas Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {t.services.map((service, index) => (
          <article
            class:list={[
              "reveal-init rounded-[2px] p-8 flex flex-col justify-between group bg-white border border-slate-200/90 shadow-sm glass-card-hover",
              `stagger-${(index % 3) + 1}`
            ]}
          >
            <div>
              <div class="w-12 h-12 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400 mb-6 group-hover:bg-gold-600 group-hover:text-white transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2v20" />
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
                </svg>
              </div>

              <h2 class="text-xl font-bold text-navy-950 group-hover:text-gold-700 transition-colors mb-3 min-h-[56px] flex items-start">
                {service.title}
              </h2>

              <p class="text-sm text-slate-600 leading-relaxed mb-6 min-h-[68px]">
                {service.shortDesc}
              </p>

              <!-- Preview Bullet Points -->
              <ul class="space-y-2 mb-8 text-xs text-slate-600 min-h-[72px]">
                {service.keyPoints.slice(0, 3).map((point) => (
                  <li class="flex items-start gap-2">
                    <span class="text-gold-600 font-bold mt-0.5">•</span>
                    <span class="line-clamp-2">{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-5 border-t border-slate-100">
              <a
                href={`/${lang}/services/${service.slug}/`}
                class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-navy-900 group-hover:text-gold-700 transition-colors"
              >
                <span>{t.servicesSection.learnMore}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1.5 transform group-hover:translate-x-1.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Bottom Consultation CTA -->
    <HomeCta lang={lang} />
  </main>

  <Footer lang={lang} />
</BaseLayout>
