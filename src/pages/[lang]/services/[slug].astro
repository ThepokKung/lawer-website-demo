---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';
import { useTranslations, type SupportedLang } from '@/i18n';
import { SITE_CONFIG } from '@/config/site';

export function getStaticPaths() {
  const locales: SupportedLang[] = ['th', 'en', 'zh'];
  const paths: Array<{ params: { lang: SupportedLang; slug: string } }> = [];

  locales.forEach((lang) => {
    const t = useTranslations(lang);
    t.services.forEach((service) => {
      paths.push({
        params: {
          lang,
          slug: service.slug
        }
      });
    });
  });

  return paths;
}

const { lang, slug } = Astro.params as { lang: SupportedLang; slug: string };
const t = useTranslations(lang);

const service = t.services.find((s) => s.slug === slug);
if (!service) {
  throw new Error(`Service not found: ${slug}`);
}

const steps = {
  th: [
    { num: "01", title: "รับฟังข้อเท็จจริงและตรวจเอกสาร", desc: "ทนายความผู้เชี่ยวชาญรับฟังรายละเอียดและตรวจความสมบูรณ์ของเอกสารเบื้องต้นอย่างเป็นความลับ" },
    { num: "02", title: "วางกลยุทธ์และประเมินความเสี่ยง", desc: "วิเคราะห์ข้อกฎหมาย วางแผนโครงสร้างทางนิติกรรมหรือแผนการดำเนินคดี พร้อมชี้แจงกรอบเวลาและค่าใช้จ่าย" },
    { num: "03", title: "ดำเนินการทางกฎหมายอย่างแม่นยำ", desc: "ยื่นคำขอ เจรจาต่อรอง หรือว่าความในศาลอย่างรัดกุม รวดเร็ว พร้อมรายงานความคืบหน้าให้ท่านทราบสม่ำเสมอ" },
    { num: "04", title: "ติดตามผลและคุ้มครองผลประโยชน์", desc: "ดูแลจนสิ้นสุดกระบวนการ บังคับใช้สิทธิตามกฎหมาย และให้คำแนะนำเชิงป้องกันสำหรับอนาคต" }
  ],
  en: [
    { num: "01", title: "Confidential Fact-Finding", desc: "Senior attorneys conduct a thorough, privileged review of all underlying facts and commercial documentation." },
    { num: "02", title: "Strategic Legal Appraisal", desc: "We evaluate statutory risks, architect transaction structures or litigation plans, and present transparent budgets." },
    { num: "03", title: "Meticulous Execution", desc: "Prompt submission of filings, high-stakes commercial negotiations, or vigorous courtroom advocacy with regular reporting." },
    { num: "04", title: "Enforcement & Long-Term Shield", desc: "Post-resolution enforcement, securing definitive rights, and implementing proactive risk mitigation protocols." }
  ],
  zh: [
    { num: "01", title: "初审案情与绝密证据调档", desc: "涉外主办律师在法定保密特权下，深度审阅全案事实、商业合同及底层往来凭证。" },
    { num: "02", title: "顶层战略研判与合规方案", desc: "精准剖析泰方法律适格性，出具可行性方案、风控推演模型与阶段性明确预算。" },
    { num: "03", title: "精细化法律实操落地", desc: "官方申报、谈判博弈或法庭辩论，由专属团队全权代理出庭，定期同步案件全流程进展。" },
    { num: "04", title: "裁决执行与长效防线构建", desc: "推动判决书或行政批复强制执行，确保商业权益完全落地，并制定企业长期防范预案。" }
  ]
}[lang];
---

<BaseLayout
  title={`${service.title} | ${t.brand.name}`}
  description={`${service.shortDesc} - ${t.brand.legalName}`}
  lang={lang}
>
  <Navbar lang={lang} />

  <main class="pt-8 pb-24">
    <!-- Breadcrumbs -->
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 mb-6" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2 text-xs text-slate-500">
        <li>
          <a href={`/${lang}/`} class="hover:text-gold-700 transition-colors">{t.nav.home}</a>
        </li>
        <li><span>/</span></li>
        <li>
          <a href={`/${lang}/services/`} class="hover:text-gold-700 transition-colors">{t.nav.services}</a>
        </li>
        <li><span>/</span></li>
        <li class="text-gold-700 font-semibold truncate max-w-xs">{service.title}</li>
      </ol>
    </nav>

    <!-- Service Header Banner -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="rounded-[2px] p-8 sm:p-12 lg:p-16 border border-slate-200 bg-white shadow-sm relative overflow-hidden">
        <div class="max-w-3xl">
          <div class="reveal-init inline-flex items-center gap-2 px-3 py-1 rounded-[2px] bg-gold-100 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider mb-6">
            <svg class="w-3.5 h-3.5 text-gold-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
            <span>{t.servicesSection.sectionBadge}</span>
          </div>

          <h1 class="reveal-init stagger-1 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy-950 tracking-tight leading-[1.3] sm:leading-[1.25] mb-6 break-words">
            {service.title}
          </h1>

          <p class="reveal-init stagger-2 text-base sm:text-lg text-slate-600 leading-relaxed mb-8">
            {service.overview}
          </p>

          <div class="reveal-init stagger-3 flex flex-wrap gap-4">
            <a
              href={`/${lang}/contact/?service=${encodeURIComponent(service.title)}`}
              class="inline-flex items-center justify-center px-8 py-4 text-sm font-bold uppercase tracking-wider text-white rounded-[2px] bg-navy-900 hover:bg-gold-600 shadow-md transition-all active:scale-[0.98]"
            >
              {t.hero.ctaConsultation}
            </a>

            <a
              href={`tel:${t.contact.phoneValue.replace(/\s+/g, '')}`}
              class="track-call inline-flex items-center justify-center px-8 py-4 text-sm font-bold uppercase tracking-wider text-navy-950 hover:text-white rounded-[2px] bg-white hover:bg-navy-900 border-2 border-slate-300 hover:border-navy-900 shadow-xs transition-all active:scale-[0.98]"
              data-phone={t.contact.phoneValue}
            >
              <svg class="w-4 h-4 mr-2 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>{t.contact.phoneValue}</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Key Strategic Capabilities Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        
        <!-- Left: Scope of Practice -->
        <div class="lg:col-span-2 space-y-8">
          <div class="reveal-init">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-950 mb-6">
              {lang === 'th' ? 'ขอบเขตความเชี่ยวชาญและการดำเนินการ' : lang === 'zh' ? '业务具体范围与核心法律服务' : 'Specific Scope of Practice & Capabilities'}
            </h2>
            <div class="space-y-3.5">
              {service.keyPoints.map((point) => (
                <div class="rounded-[2px] p-5 flex items-start gap-4 border border-slate-200 bg-white shadow-2xs">
                  <div class="w-6 h-6 rounded-[2px] bg-gold-100 border border-gold-300 flex items-center justify-center text-gold-800 shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5 text-gold-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                  </div>
                  <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
                    {point}
                  </p>
                </div>
              ))}
            </div>
          </div>

          <!-- Ideal Clients -->
          <div class="reveal-init rounded-[2px] p-6 sm:p-8 border border-slate-200 bg-slate-50">
            <h3 class="text-xs font-bold uppercase tracking-wider text-gold-800 mb-2">
              {lang === 'th' ? 'บริการนี้เหมาะสำหรับใคร' : lang === 'zh' ? '核心受众与适用对象' : 'Who This Service Is For'}
            </h3>
            <p class="text-sm sm:text-base text-slate-700 leading-relaxed">
              {service.forWhom}
            </p>
          </div>
        </div>

        <!-- Right: Quick Contact & Consultation Sidebar -->
        <div class="lg:col-span-1">
          <div class="reveal-init rounded-[2px] p-6 sm:p-8 border border-slate-200 bg-white shadow-sm sticky top-28 space-y-6">
            <h3 class="text-lg font-bold text-navy-950">
              {t.contact.formTitle}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              {t.contact.formDesc}
            </p>

            <div class="space-y-3 pt-2">
              <a
                href={`/${lang}/contact/?service=${encodeURIComponent(service.title)}`}
                class="w-full inline-flex items-center justify-center py-3 text-xs font-bold uppercase tracking-wider text-white rounded-[2px] bg-navy-900 hover:bg-gold-600 shadow-sm transition-all active:scale-[0.98]"
              >
                {t.contact.fieldSubmit}
              </a>

              <a
                href={SITE_CONFIG.lineUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="track-line w-full inline-flex items-center justify-center py-2.5 text-xs font-semibold text-[#06C755] rounded-[2px] bg-[#06C755]/10 border border-[#06C755]/30 hover:bg-[#06C755]/20 transition-all"
              >
                LINE Official: {t.contact.lineValue}
              </a>

              <a
                href={`tel:${t.contact.phoneValue.replace(/\s+/g, '')}`}
                class="track-call w-full inline-flex items-center justify-center py-2.5 text-xs font-semibold text-slate-700 rounded-[2px] bg-slate-50 border border-slate-200 hover:border-navy-900 transition-all gap-1.5"
                data-phone={t.contact.phoneValue}
              >
                <svg class="w-3.5 h-3.5 text-gold-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>{t.contact.phoneValue}</span>
              </a>
            </div>

            <div class="pt-4 border-t border-slate-100 text-[11px] text-slate-500 flex items-center justify-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-gold-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <span>{t.contact.subtitle}</span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- 4-Step Process Section -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="reveal-init text-2xl sm:text-3xl font-extrabold text-navy-950 mb-3">
          {lang === 'th' ? 'ขั้นตอนการทำงานและการให้บริการ' : lang === 'zh' ? '全案服务标准化实操流程' : 'Our Advisory & Representation Process'}
        </h2>
        <p class="reveal-init stagger-1 text-sm text-slate-600">
          {lang === 'th' ? 'มาตรฐานการทำงานที่โปร่งใส ชัดเจนในทุกขั้นตอน' : lang === 'zh' ? '透明高效的标准作业流程，全流程由合伙人严密督导' : 'Transparent, disciplined execution from consultation to completion.'}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {steps.map((st, i) => (
          <div class:list={["reveal-init rounded-[2px] p-6 border border-slate-200 bg-white shadow-2xs flex flex-col justify-between", `stagger-${i + 1}`]}>
            <div>
              <div class="text-3xl font-black text-gold-600 font-mono mb-3">
                {st.num}
              </div>
              <h3 class="text-base font-bold text-navy-950 mb-2">
                {st.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {st.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

  </main>

  <Footer lang={lang} />
</BaseLayout>
