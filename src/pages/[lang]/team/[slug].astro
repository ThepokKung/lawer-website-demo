---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/common/Navbar.astro';
import Footer from '@/components/common/Footer.astro';
import { useTranslations, type SupportedLang } from '@/i18n';
import { SITE_CONFIG } from '@/config/site';

export function getStaticPaths() {
  const locales: SupportedLang[] = ['th', 'en'];
  const paths: Array<{ params: { lang: SupportedLang; slug: string } }> = [];

  locales.forEach((lang) => {
    const t = useTranslations(lang);
    t.attorneys.forEach((attorney) => {
      paths.push({
        params: {
          lang,
          slug: attorney.slug
        }
      });
    });
  });

  return paths;
}

const { lang, slug } = Astro.params as { lang: SupportedLang; slug: string };
const t = useTranslations(lang);

const attorney = t.attorneys.find((a) => a.slug === slug);
if (!attorney) {
  throw new Error(`Attorney profile not found: ${slug}`);
}

const otherAttorneys = t.attorneys.filter((a) => a.slug !== slug);
const siteUrl = SITE_CONFIG.url;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Attorney",
  "name": attorney.name,
  "alternateName": attorney.nameEn || undefined,
  "jobTitle": attorney.role,
  "image": `${siteUrl}${attorney.image}`,
  "telephone": t.contact.phoneValue,
  "email": t.contact.emailValue,
  "url": `${siteUrl}/${lang}/team/${attorney.slug}/`,
  "worksFor": {
    "@type": "LegalService",
    "name": t.brand.name,
    "url": siteUrl
  },
  "knowsLanguage": attorney.languages,
  "description": attorney.bio[0]
};
---

<BaseLayout
  title={`${attorney.name} | ${t.brand.name}`}
  description={`${attorney.name} - ${attorney.role}. ${attorney.bio[0].slice(0, 150)}...`}
  lang={lang}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  <Navbar lang={lang} />

  <main class="pt-8 pb-24">
    <!-- Breadcrumb -->
    <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4 mb-4" aria-label="Breadcrumb">
      <ol class="flex items-center space-x-2 text-xs text-slate-500">
        <li>
          <a href={`/${lang}/`} class="hover:text-gold-700 transition-colors">{t.nav.home}</a>
        </li>
        <li><span>/</span></li>
        <li>
          <a href={`/${lang}/about/#team`} class="hover:text-gold-700 transition-colors">{t.teamSection.sectionBadge}</a>
        </li>
        <li><span>/</span></li>
        <li class="text-gold-700 font-semibold truncate max-w-xs">{attorney.name}</li>
      </ol>
    </nav>

    <!-- Main Profile Hero Card -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-14">
      <div class="rounded-[2px] border border-slate-200 bg-white shadow-sm overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
          
          <!-- Left: Portrait & Direct Contact Quick Info (4 cols) -->
          <div class="lg:col-span-4 p-6 sm:p-8 bg-slate-50 border-b lg:border-b-0 lg:border-r border-slate-200 flex flex-col justify-between">
            <div>
              <!-- Portrait Photo -->
              <div class="relative w-full aspect-[4/5] rounded-[2px] overflow-hidden border-2 border-slate-200 shadow-md mb-6 bg-slate-200">
                <img
                  src={attorney.image}
                  alt={attorney.name}
                  class="w-full h-full object-cover object-top filter brightness-[1.01] contrast-[1.02]"
                  width="400"
                  height="500"
                  loading="eager"
                  fetchpriority="high"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/40 via-transparent to-transparent pointer-events-none"></div>
                <div class="absolute top-3 left-3 bg-navy-950/85 backdrop-blur-xs text-gold-400 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-[2px] border border-gold-500/30">
                  {attorney.roleBadge}
                </div>
              </div>

              <!-- Quick Meta -->
              <div class="space-y-3 text-xs text-slate-700">
                <div class="p-3 bg-white rounded-[2px] border border-slate-200/90 shadow-2xs">
                  <span class="block text-[10px] uppercase font-bold text-slate-400 tracking-wider mb-1">
                    {t.attorneyPage.licenseLabel}
                  </span>
                  <span class="font-semibold text-navy-950 block leading-snug">
                    {attorney.licenseNumber}
                  </span>
                </div>

                <div class="p-3 bg-white rounded-[2px] border border-slate-200/90 shadow-2xs">
                  <span class="block text-[10px] uppercase font-bold text-slate-400 tracking-wider mb-1">
                    {t.attorneyPage.languagesLabel}
                  </span>
                  <span class="font-semibold text-navy-950 block">
                    {attorney.languages.join(' • ')}
                  </span>
                </div>
              </div>
            </div>

            <!-- Direct Contact Actions -->
            <div class="pt-6 space-y-2.5">
              <a
                href={`tel:${t.contact.phoneValue.replace(/\s+/g, '')}`}
                class="track-call w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-[2px] text-xs font-semibold text-slate-800 bg-white border border-slate-300 hover:border-navy-900 transition-colors shadow-2xs"
                data-phone={t.contact.phoneValue}
              >
                <svg class="w-3.5 h-3.5 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>{t.contact.phoneValue}</span>
              </a>

              <a
                href={SITE_CONFIG.lineUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="track-line w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-[2px] text-xs font-semibold text-[#06C755] bg-[#06C755]/10 border border-[#06C755]/30 hover:bg-[#06C755]/20 transition-colors"
              >
                <span>LINE: {t.contact.lineValue}</span>
              </a>
            </div>

          </div>

          <!-- Right: Detailed Overview, Quotes & Bio (8 cols) -->
          <div class="lg:col-span-8 p-6 sm:p-10 lg:p-12 flex flex-col justify-between">
            <div class="space-y-6">
              <div>
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-[2px] bg-gold-100 border border-gold-300 text-gold-800 text-xs font-bold uppercase tracking-wider mb-4">
                  <span>{t.attorneyPage.sectionBadge}</span>
                </div>
                <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy-950 tracking-tight mb-2">
                  {attorney.name}
                </h1>
                <p class="text-sm sm:text-base font-bold text-gold-700 uppercase tracking-wider">
                  {attorney.role}
                </p>
              </div>

              <!-- Executive Quote / Motto -->
              <div class="p-4 sm:p-5 rounded-[2px] bg-slate-50 border-l-4 border-gold-500 text-slate-700 italic text-sm sm:text-base leading-relaxed">
                “{attorney.quote}”
              </div>

              <!-- Biography Narrative -->
              <div class="space-y-4 text-sm sm:text-base text-slate-600 leading-relaxed">
                {attorney.bio.map((para) => (
                  <p>{para}</p>
                ))}
              </div>

              <!-- Core Practice Pills -->
              <div class="pt-4">
                <span class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">
                  {t.attorneyPage.practiceAreasTitle}
                </span>
                <div class="flex flex-wrap gap-2">
                  {attorney.practiceAreas.map((area) => (
                    <span class="inline-flex items-center px-3 py-1 rounded-[2px] text-xs font-semibold bg-slate-100 text-navy-950 border border-slate-200">
                      {area}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Action Button -->
            <div class="pt-8 mt-8 border-t border-slate-100 flex flex-wrap items-center gap-4">
              <a
                href={`/${lang}/contact/?attorney=${encodeURIComponent(attorney.name)}`}
                class="inline-flex items-center justify-center px-8 py-4 text-xs sm:text-sm font-bold uppercase tracking-wider text-white rounded-[2px] bg-navy-900 hover:bg-gold-600 shadow-md hover:shadow-lg transition-all active:scale-[0.98]"
              >
                <span>{t.attorneyPage.scheduleConsultation}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>

              <a
                href={`/${lang}/about/#team`}
                class="inline-flex items-center text-xs font-bold uppercase tracking-wider text-slate-600 hover:text-navy-950 transition-colors py-4 px-2"
              >
                <span>← {t.attorneyPage.backToTeam}</span>
              </a>
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- Deep-Dive Credentials Section (Education, Admissions, Experience) -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Left: Education Timeline -->
        <div class="rounded-[2px] p-6 sm:p-8 bg-white border border-slate-200 shadow-xs space-y-6">
          <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
            <div class="w-9 h-9 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400 shrink-0">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M12 14l9-5-9-5-9 5 9 5z" />
                <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              </svg>
            </div>
            <div>
              <h2 class="text-lg font-bold text-navy-950">{t.attorneyPage.educationTitle}</h2>
              <span class="text-xs text-slate-500">Academic Background & Diplomas</span>
            </div>
          </div>

          <div class="space-y-4">
            {attorney.education.map((edu) => (
              <div class="p-4 rounded-[2px] bg-slate-50 border border-slate-200 flex items-start gap-4">
                <span class="px-2.5 py-1 rounded-[2px] bg-gold-100 text-gold-800 text-xs font-mono font-bold shrink-0 border border-gold-300">
                  {edu.year}
                </span>
                <div>
                  <h3 class="text-sm font-bold text-navy-950 mb-0.5">{edu.degree}</h3>
                  <p class="text-xs text-slate-600">{edu.institution}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Right: Admissions & Key Experience -->
        <div class="space-y-8">
          
          <!-- Admissions -->
          <div class="rounded-[2px] p-6 sm:p-8 bg-white border border-slate-200 shadow-xs space-y-6">
            <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
              <div class="w-9 h-9 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-bold text-navy-950">{t.attorneyPage.admissionsTitle}</h2>
                <span class="text-xs text-slate-500">Bar Admissions & Professional Certifications</span>
              </div>
            </div>

            <ul class="space-y-3">
              {attorney.admissions.map((adm) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-700">
                  <span class="w-5 h-5 rounded-[2px] bg-gold-100 text-gold-700 flex items-center justify-center shrink-0 mt-0.5 font-bold">✓</span>
                  <span>{adm.title}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Career Highlights -->
          <div class="rounded-[2px] p-6 sm:p-8 bg-white border border-slate-200 shadow-xs space-y-6">
            <div class="flex items-center gap-3 border-b border-slate-100 pb-4">
              <div class="w-9 h-9 rounded-[2px] bg-navy-900 border border-navy-800 flex items-center justify-center text-gold-400 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h2 class="text-lg font-bold text-navy-950">{t.attorneyPage.experienceTitle}</h2>
                <span class="text-xs text-slate-500">Distinguished Record & High-Stakes Engagements</span>
              </div>
            </div>

            <ul class="space-y-3">
              {attorney.experienceHighlights.map((exp) => (
                <li class="flex items-start gap-3 text-xs sm:text-sm text-slate-700">
                  <span class="text-gold-600 font-bold shrink-0 mt-0.5">•</span>
                  <span class="leading-relaxed">{exp}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>

      </div>
    </section>

    <!-- Other Attorneys in the Firm -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-950 mb-2">
          {t.attorneyPage.otherAttorneysTitle}
        </h2>
        <p class="text-xs sm:text-sm text-slate-600">
          {t.teamSection.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {otherAttorneys.map((other) => (
          <a
            href={`/${lang}/team/${other.slug}/`}
            class="group rounded-[2px] p-5 bg-white border border-slate-200 hover:border-gold-500 shadow-xs hover:shadow-md transition-all flex items-center gap-4"
          >
            <div class="w-16 h-20 rounded-[2px] overflow-hidden border border-slate-200 bg-slate-100 shrink-0">
              <img
                src={other.image}
                alt={other.name}
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform"
                width="160"
                height="200"
                loading="lazy"
              />
            </div>
            <div class="min-w-0">
              <h3 class="text-sm font-bold text-navy-950 group-hover:text-gold-700 transition-colors truncate">
                {other.name}
              </h3>
              <p class="text-[11px] text-gold-700 font-semibold truncate mb-1">
                {other.roleBadge}
              </p>
              <span class="text-[11px] text-slate-500 inline-flex items-center gap-1 group-hover:underline">
                <span>View Profile</span>
                <span>→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </main>

  <Footer lang={lang} />
</BaseLayout>
